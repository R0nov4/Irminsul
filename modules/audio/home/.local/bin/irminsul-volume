# ───────────────────────────── the popup ─────────────────────────────
class Popup(Gtk.Window):
    def __init__(self, place):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.use_ls = bool(LS) and LS.is_supported()
        self.get_style_context().add_class("irm")
        self.set_title("Resonance Mixer"); self.set_decorated(False); self.set_resizable(False)
        self.set_app_paintable(True); self.set_default_size(WIDTH, 1)
        scr = self.get_screen(); vis = scr.get_rgba_visual()
        if vis is not None and scr.is_composited():
            self.set_visual(vis)
        self.st = None; self.cur_sink = None; self.hold = {}; self.pending = {}; self.flush_id = 0
        self.refreshing = False; self.refresh_id = 0; self.dev_sig = None; self.app_sig = None
        self.last_sink = None; self.opened = time.monotonic(); self.apps = {}; self.cards = []

        self.catcher = None
        if self.use_ls:
            self._setup_layer(place)
        else:
            self.set_position(Gtk.WindowPosition.CENTER if CENTER else Gtk.WindowPosition.MOUSE)

        # content: keep the dial and footer fixed; put every variable-height control
        # in one viewport so device rows cannot be clipped by a nested scroller.
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        root.set_margin_start(32); root.set_margin_end(32); root.set_margin_top(22); root.set_margin_bottom(22)
        head = Gtk.Box(spacing=0); self.title = TitleBar()
        head.pack_start(self.title, True, True, 0); head.pack_start(IconBtn("close", self.close_all, 30), False, False, 0)
        root.pack_start(head, False, False, 0)
        self.dial = Dial(self.on_master_vol, self.on_master_mute); root.pack_start(self.dial, False, False, 0)
        self.chips = Chips(self.on_master_vol_final); root.pack_start(self.chips, False, False, 2)

        controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        controls.set_margin_end(10)
        self.coop_busy = False
        self.coop_btn = Pill("Enable Co-op", lambda: self.on_coop("toggle"))
        controls.pack_start(self.coop_btn, False, False, 0)
        self.coop_status = Gtk.Label(label="", xalign=0)
        self.coop_status.get_style_context().add_class("empty")
        self.coop_status.set_line_wrap(True); self.coop_status.set_max_width_chars(46)
        self.coop_status.set_no_show_all(True)
        controls.pack_start(self.coop_status, False, False, 0)
        self.out_h = Ornament("Output Devices"); controls.pack_start(self.out_h, False, False, 0)
        self.dev_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        controls.pack_start(self.dev_box, False, False, 0)

        self.app_h = Ornament("Party Mixer"); controls.pack_start(self.app_h, False, False, 0)
        self.apps_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.empty = Gtk.Label(label="Nothing is making sound right now.", xalign=0)
        self.empty.get_style_context().add_class("empty")
        controls.pack_start(self.apps_box, False, False, 0)

        self.mic_wrap = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4); self.mic_wrap.set_no_show_all(True)
        self.mic_h = Ornament("Microphone"); self.mic_wrap.pack_start(self.mic_h, False, False, 0)
        mrow = Gtk.Box(spacing=8)
        self.mic_btn = IconBtn("mic", self.on_mic_mute, 32); self.mic_sl = Slider(self.on_mic_vol)
        mrow.pack_start(self.mic_btn, False, False, 0); mrow.pack_start(self.mic_sl, True, True, 0)
        self.mic_wrap.pack_start(mrow, False, False, 0); controls.pack_start(self.mic_wrap, False, False, 0)

        self.controls_scroll = Gtk.ScrolledWindow()
        self.controls_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.controls_scroll.set_overlay_scrolling(False)
        self.controls_scroll.set_propagate_natural_height(True)
        try:
            screen_h = self.get_screen().get_height()
        except Exception:
            screen_h = 900
        body_h = max(120, min(300, screen_h - 600))
        self.controls_scroll.set_min_content_height(60)
        self.controls_scroll.set_max_content_height(body_h)
        self.controls_scroll.add(controls)
        root.pack_start(self.controls_scroll, True, True, 0)

        foot = Gtk.Box(spacing=10, homogeneous=True); foot.set_margin_top(2)
        foot.pack_start(Pill("Test chime", lambda: POOL.submit(play_chime)), True, True, 0)
        foot.pack_start(Pill("Sound settings", self.open_settings), True, True, 0)
        root.pack_start(foot, False, False, 0)
        self.add(root)

        self.connect("draw", self.draw_panel)
        self.connect("key-press-event", self.on_key)
        self.connect("destroy", lambda *_: self.shutdown())
        if not self.use_ls:
            self.connect("focus-out-event", lambda *_: self.close_all() if time.monotonic() - self.opened > 0.6 else None)

        self.meter = Meter(); self.meter.start()
        self.watcher = Watcher(self.on_event); self.watcher.start()
        self.refresh(); self.set_opacity(0.0)
        self.last_t = time.monotonic(); GLib.timeout_add(33, self.tick)

    # layer-shell: popup under the clicked icon + a transparent click-catcher behind it
    def _setup_layer(self, place):
        LS.init_for_window(self); LS.set_namespace(self, "irminsul-volume"); LS.set_layer(self, LS.Layer.OVERLAY)
        LS.set_keyboard_mode(self, LS.KeyboardMode.EXCLUSIVE)
        anchor_bottom, left, gap = place
        if not CENTER:
            LS.set_anchor(self, LS.Edge.LEFT, True)
            LS.set_anchor(self, LS.Edge.BOTTOM if anchor_bottom else LS.Edge.TOP, True)
            LS.set_margin(self, LS.Edge.LEFT, int(left))
            LS.set_margin(self, LS.Edge.BOTTOM if anchor_bottom else LS.Edge.TOP, int(gap))
        # CENTER: no anchors at all -> the compositor centres the surface on the focused output
        c = Gtk.Window(type=Gtk.WindowType.TOPLEVEL); c.set_app_paintable(True)
        scr = c.get_screen()
        if scr.get_rgba_visual() is not None:
            c.set_visual(scr.get_rgba_visual())
        c.get_style_context().add_class("irm")
        LS.init_for_window(c); LS.set_namespace(c, "irminsul-volume-catcher"); LS.set_layer(c, LS.Layer.TOP)
        for e in (LS.Edge.TOP, LS.Edge.BOTTOM, LS.Edge.LEFT, LS.Edge.RIGHT):
            LS.set_anchor(c, e, True)
        LS.set_exclusive_zone(c, -1); LS.set_keyboard_mode(c, LS.KeyboardMode.NONE)
        c.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
        c.connect("draw", lambda w, cr: (cr.set_operator(cairo.OPERATOR_SOURCE), cr.set_source_rgba(0, 0, 0, 0.004), cr.paint(), True)[-1])
        c.connect("button-press-event", lambda *_: self.close_all())
        c.show_all(); self.catcher = c

    def draw_panel(self, w, cr):
        W, H = w.get_allocated_width(), w.get_allocated_height()
        cr.set_operator(cairo.OPERATOR_CLEAR); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        x, y, pw, ph = 10, 8, W - 20, H - 18
        for i in range(7):                                   # soft shadow
            rrect(cr, x - i, y - i + 4, pw + 2 * i, ph + 2 * i, 18 + i); A(cr, (0, 0, 0), 0.05); cr.fill()
        rrect(cr, x, y, pw, ph, 18)
        g = cairo.LinearGradient(0, y, 0, y + ph); g.add_color_stop_rgb(0, 0.215, 0.24, 0.32); g.add_color_stop_rgb(1, 0.15, 0.17, 0.24)
        cr.set_source(g); cr.fill_preserve(); A(cr, GOLD, 0.95); cr.set_line_width(1.8); cr.stroke()
        rng = random.Random(7)                               # faint star-dust, stable per size
        for _ in range(26):
            sx, sy = x + 18 + rng.random() * (pw - 36), y + 18 + rng.random() * (ph - 36)
            star(cr, sx, sy, 2 + rng.random() * 3.2, 0.25); A(cr, GOLD, 0.05 + rng.random() * 0.08); cr.fill()
        rrect(cr, x + 7, y + 7, pw - 14, ph - 14, 12); A(cr, GOLD, 0.30); cr.set_line_width(1); cr.stroke()
        for cx_, cy_ in ((x + 7, y + 7), (x + pw - 7, y + 7), (x + 7, y + ph - 7), (x + pw - 7, y + ph - 7)):
            diamond(cr, cx_, cy_, 4.2); A(cr, NAVY); cr.fill_preserve(); A(cr, GOLD); cr.set_line_width(1.2); cr.stroke()
        mx = x + pw / 2                                       # top-centre notch
        for dx in (-16, 16):
            diamond(cr, mx + dx, y, 2.4); A(cr, GOLD); cr.fill()
        diamond(cr, mx, y, 6); A(cr, NAVY); cr.fill_preserve(); A(cr, GOLD); cr.set_line_width(1.4); cr.stroke()
        return False

    # ── lifecycle ──
    def tick(self):
        now = time.monotonic(); dt = now - self.last_t; self.last_t = now
        self.dial.level = self.meter.level; self.dial.tick(dt)
        self.title.t += dt * 0.6; self.title.queue_draw()
        age = now - self.opened
        if age < 0.2:
            self.set_opacity(min(1.0, age / 0.2))
        elif self.get_opacity() < 1.0:
            self.set_opacity(1.0)
        return True

    def on_key(self, w, e):
        k = Gdk.keyval_name(e.keyval)
        if k == "Escape":
            self.close_all()
        elif k in ("Up", "Right"):
            self.on_master_vol(min(100, self.dial.vol + 5)); self.dial.vol = min(100, self.dial.vol + 5)
        elif k in ("Down", "Left"):
            self.on_master_vol(max(0, self.dial.vol - 5)); self.dial.vol = max(0, self.dial.vol - 5)
        elif k in ("m", "M", "space"):
            self.on_master_mute()
        return True

    def close_all(self):
        if self.catcher:
            self.catcher.destroy()
        self.destroy()

    def shutdown(self):
        if self.flush_id:
            GLib.source_remove(self.flush_id); self.flush_id = 0
            self._flush()
        for t in (self.meter, self.watcher):
            t.close()
        try:
            os.remove(PIDF)
        except Exception:
            pass
        Gtk.main_quit()

    def open_settings(self):
        # We re-exec'd with LD_PRELOAD=libgtk-layer-shell (a GTK3 lib). Children must not inherit it,
        # or GTK4 apps (pavucontrol 6, pwvucontrol...) abort with "GTK 2/3 symbols detected".
        env = dict(os.environ)
        env.pop("IRMINSUL_NO_REEXEC", None)
        pre = [x for x in env.get("LD_PRELOAD", "").split(":") if x and "gtk-layer-shell" not in x]
        if pre:
            env["LD_PRELOAD"] = ":".join(pre)
        else:
            env.pop("LD_PRELOAD", None)
        for cmd in (["irminsul-settings"], ["pavucontrol"], ["pwvucontrol"], ["gnome-control-center", "sound"]):
            try:
                subprocess.Popen(cmd, start_new_session=True, env=env); break
            except Exception:
                continue
        self.close_all()

    # ── commands (throttled while dragging) ──
    def held(self, key):
        return time.monotonic() < self.hold.get(key, 0)

    def touch(self, key, secs=0.7):
        self.hold[key] = time.monotonic() + secs

    def queue(self, key, cmd):
        self.pending[key] = cmd
        if not self.flush_id:
            self.flush_id = GLib.timeout_add(45, self._flush)

    def _flush(self):
        for cmd in self.pending.values():
            COMMANDS.submit(run, cmd)
        self.pending.clear(); self.flush_id = 0
        return False

    def sink_name(self):
        return self.cur_sink["name"] if self.cur_sink else "@DEFAULT_SINK@"

    def on_master_vol(self, v):
        self.touch("master"); self.queue("master", ["pactl", "set-sink-volume", self.sink_name(), f"{int(round(v))}%"])
        if self.dial.muted and v > 0:
            self.dial.muted = False; COMMANDS.submit(run, ["pactl", "set-sink-mute", self.sink_name(), "0"])
        self.chips.vol = v; self.chips.queue_draw()

    def on_master_vol_final(self, v):
        self.dial.vol = float(v); self.on_master_vol(v)

    def on_master_mute(self):
        self.touch("master"); self.dial.muted = not self.dial.muted
        COMMANDS.submit(run, ["pactl", "set-sink-mute", self.sink_name(), "toggle"])

    def on_device_vol(self, d, v):
        key = "device:" + d["name"]
        self.touch(key)
        self.queue(key, ["pactl", "set-sink-volume", d["name"], f"{int(round(v))}%"])

    def on_device_mute(self, d):
        COMMANDS.submit(run, ["pactl", "set-sink-mute", d["name"], "toggle"])

    def say(self, msg):
        msg = msg or ""
        self.coop_status.set_text(msg)
        (self.coop_status.show if msg else self.coop_status.hide)()
        if getattr(self, "say_id", 0):
            GLib.source_remove(self.say_id); self.say_id = 0
        if msg:
            self.say_id = GLib.timeout_add_seconds(6, lambda: (self.say(""), False)[1])

    def on_coop(self, action, name=None):
        if self.coop_busy:
            return
        self.coop_busy = True
        self.coop_btn.label = "Working..."; self.coop_btn.queue_draw()
        self.say("Updating Co-op output...")
        for row in self.cards:
            row.busy = True; row.queue_draw()
        def job():
            message = coop_command(action, name)
            GLib.idle_add(done, message)
        def done(message):
            self.coop_busy = False
            self.say(message); self.refresh()
            GLib.timeout_add(700, lambda: (self.refresh(), False)[1])   # settle after the server finishes unloading
            return False
        COMMANDS.submit(job)

    def on_pick_sink(self, d):
        co = (self.st or {}).get("coop", {})
        if co.get("active") and d["name"] not in co.get("names", [co.get("name")]):
            self.say("Co-op is active: tick/untick devices, or disable Co-op to use one output")
            return
        apps = list((self.st or {}).get("apps", []))
        def job():
            if not run(["pactl", "set-default-sink", d["name"]]):
                GLib.idle_add(self.say, "Could not change output")
                return
            for a in apps:
                run(["pactl", "move-sink-input", str(a["idx"]), d["name"]])
        COMMANDS.submit(job)

    def on_app_vol(self, a, v):
        key = f'app{a["idx"]}'; self.touch(key)
        self.queue(key, ["pactl", "set-sink-input-volume", str(a["idx"]), f"{int(round(v))}%"])

    def on_app_mute(self, a):
        COMMANDS.submit(run, ["pactl", "set-sink-input-mute", str(a["idx"]), "toggle"])

    def on_mic_vol(self, v):
        self.touch("mic"); src = (self.st or {}).get("default_src", "@DEFAULT_SOURCE@")
        self.queue("mic", ["pactl", "set-source-volume", src, f"{int(round(v))}%"])

    def on_mic_mute(self):
        src = (self.st or {}).get("default_src", "@DEFAULT_SOURCE@")
        self.mic_btn.muted = not self.mic_btn.muted; self.mic_sl.muted = self.mic_btn.muted; self.mic_btn.queue_draw()
        COMMANDS.submit(run, ["pactl", "set-source-mute", src, "toggle"])

    # ── state sync ──
    def on_event(self):
        if not self.refresh_id:
            self.refresh_id = GLib.timeout_add(90, self._do_refresh)

    def _do_refresh(self):
        self.refresh_id = 0; self.refresh(); return False

    def refresh(self):
        if self.refreshing:
            self.refresh_again = True   # running snapshot may predate the change: go again when it lands
            return
        self.refreshing = True; self.refresh_again = False
        POOL.submit(lambda: GLib.idle_add(self.apply, snapshot()))

    def apply(self, st):
        self.refreshing = False; self.st = st
        if getattr(self, "refresh_again", False):
            self.refresh_again = False; GLib.timeout_add(60, lambda: (self.refresh(), False)[1])
        sinks = st["sinks"]
        cur = next((s for s in sinks if s["name"] == st["default_sink"]), sinks[0] if sinks else None)
        if cur:
            self.cur_sink = cur
            if not self.held("master") and not self.dial.drag:
                self.dial.set_state(cur["vol"], cur["mute"]); self.chips.vol = cur["vol"]; self.chips.queue_draw()
            self.dial.name, self.dial.kind = cur["desc"], cur["kind"]
            if cur["name"] != self.last_sink:
                self.last_sink = cur["name"]; self.meter.restart()
        else:
            self.cur_sink = None
            self.dial.name = "No output"; self.dial.set_state(0, False)
        # devices
        sinks = [s for s in sinks if not s["name"].startswith("irminsul_coop")]
        sig = tuple(s["name"] for s in sinks)
        if sig != self.dev_sig:
            self.dev_sig = sig
            for c in self.dev_box.get_children():
                self.dev_box.remove(c)
            self.cards = []
            for s in sinks:
                card = DeviceRow(s, self); self.dev_box.pack_start(card, False, False, 0); self.cards.append(card)
            self.dev_box.show_all(); self.resize(WIDTH, 1)
        for card, s in zip(self.cards, sinks):
            card.update(s, st)
        co = st["coop"]
        if not self.coop_busy:
            self.coop_btn.label = "Disable Co-op" if co["active"] else "Enable Co-op"
            self.coop_btn.queue_draw()
        self.out_h.set_right(f"{len(co['members'])} in Co-op" if co["active"] else f"{len(sinks)} found")
        # apps
        asig = tuple((a["idx"], a["name"]) for a in st["apps"])
        if asig != self.app_sig:
            self.app_sig = asig
            for c in self.apps_box.get_children():
                self.apps_box.remove(c)
            self.apps = {}
            if not st["apps"]:
                self.apps_box.pack_start(self.empty, False, False, 4)
            for a in st["apps"]:
                row = AppRow(a, self.on_app_vol, self.on_app_mute); self.apps[a["idx"]] = row
                self.apps_box.pack_start(row, False, False, 0)
            self.apps_box.show_all(); self.resize(WIDTH, 1)
        for a in st["apps"]:
            if a["idx"] in self.apps:
                self.apps[a["idx"]].update(a, self.held(f'app{a["idx"]}'))
        n = len(st["apps"]); self.app_h.set_right(f"{n} playing" if n else "")
        # mic
        src = next((s for s in st["srcs"] if s["name"] == st["default_src"]), st["srcs"][0] if st["srcs"] else None)
        if src:
            if not self.mic_wrap.get_visible():
                self.mic_wrap.set_no_show_all(False); self.mic_wrap.show_all(); self.resize(WIDTH, 1)
            self.mic_h.set_right(src["desc"])
            self.mic_btn.muted = src["mute"]; self.mic_btn.queue_draw()
            if not self.held("mic"):
                self.mic_sl.set(src["vol"], src["mute"])
        elif self.mic_wrap.get_visible():
            self.mic_wrap.hide(); self.resize(WIDTH, 1)
        return False


# ───────────────────────────── placement under the clicked icon ─────────────────────────────
def hypr(*args):
    try:
        return json.loads(sh("hyprctl", *args, "-j", timeout=1.5))
    except Exception:
        return None


def placement():
    """(anchor_bottom, left_margin, edge_gap). Falls back to top-right under a typical bar."""
    try:
        cur, mons = hypr("cursorpos"), hypr("monitors")
        if cur and mons:
            cx, cy = float(cur["x"]), float(cur["y"])
            mon = next((m for m in mons if m["x"] <= cx < m["x"] + m["width"] / m.get("scale", 1)
                        and m["y"] <= cy < m["y"] + m["height"] / m.get("scale", 1)), None) or mons[0]
            mw, mh = mon["width"] / mon.get("scale", 1), mon["height"] / mon.get("scale", 1)
            rx, ry = cx - mon["x"], cy - mon["y"]
            left = max(2, min(mw - WIDTH - 2, rx - WIDTH / 2 - 10))
            if ry < mh / 2:
                return False, left, ry + 18
            return True, left, (mh - ry) + 18
    except Exception:
        pass
    mw = 1920
    try:
        mw = Gdk.Display.get_default().get_monitor(0).get_geometry().width
    except Exception:
        pass
    return False, max(2, mw - WIDTH - 6), 46


def main():
    with open(PIDF, "w") as f:
        f.write(str(os.getpid()))
    prov = Gtk.CssProvider(); prov.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = Popup(placement())
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda *_: (win.close_all(), False)[1])
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, lambda *_: (win.close_all(), False)[1])
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
