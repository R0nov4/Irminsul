        "astro": "Meters frozen, or no sound at all",
    }

    def maint_row(self, y):
        y = self.section(y, "Maintenance")
        x0, x1, cy = self.row(y, "Restart Audio", self.RESTART_SUB.get(self.page, "WirePlumber, PipeWire, pipewire-pulse"), el=6,
                              info="Restarts the whole sound stack (WirePlumber, PipeWire, pipewire-pulse). Fixes stuck Bluetooth, "
                                   "missing devices and crackling. Every app reconnects within a second or two; "
                                   "your enchantments are re-applied.")
        self.gbutton("restart", x1 - 190, cy - 20, 190, 40, "Restart", lambda: self.ask(
            "Restart the sound stack?", "All audio stops for a moment while WirePlumber, PipeWire and pipewire-pulse "
            "restart. Saved enchantments are re-applied afterwards.", "Restart", self.restart_stack), glyph="restart", dark=True)
        return y + 62

    def restart_stack(self):
        self.toast("Restarting the sound stack…")

        def job():
            run(["systemctl", "--user", "restart", "wireplumber", "pipewire", "pipewire-pulse"])
            time.sleep(2.0); restore_all(); self.rt.update(load_rt())
            self.host.idle(lambda: (self.toast("The ley lines are flowing again"), self.refresh()))
        POOL.submit(job)

