DEMO = PREVIEW or "--demo" in sys.argv
SELF = os.path.abspath(__file__)
CFG_DIR = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "irminsul-volume")
CFG_PATH = os.path.join(CFG_DIR, "settings.json")
RT_PATH = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "irminsul-state.json")
EQ_CONF = os.path.join(CFG_DIR, "irminsul-eq.conf")
POOL = ThreadPoolExecutor(max_workers=4)
COMMANDS = ThreadPoolExecutor(max_workers=1)  # last slider value must be applied last

try:
    import numpy as np
except Exception:
    np = None

if PREVIEW:
    import cairocffi as cairo
    Gtk = Gdk = GLib = Gio = Pango = PangoCairo = None
else:
    import gi
    gi.require_version("Gtk", "3.0"); gi.require_version("Gdk", "3.0")
    gi.require_version("Pango", "1.0"); gi.require_version("PangoCairo", "1.0")
    from gi.repository import Gtk, Gdk, GLib, Gio, Pango, PangoCairo
    import cairo

