    ("Cryo · Crystal", [0, 0, 0, 0, 0, 1, 2, 4, 5, 6]),
    ("Electro · Surge", [5, 4, 2, 0, -2, -2, 0, 2, 4, 5]),
    ("Pyro · Ember", [5, 4, 2, 0, -1, 0, 1, 3, 4, 4]),
    ("Dendro · Grove", [-6, -4, -2, 0, 2, 3, 3, 2, 0, -2]),
]
DEFAULTS = {
    "position": "center", "scroll_step": 3, "ceiling": 100, "boost_limit": 150,
