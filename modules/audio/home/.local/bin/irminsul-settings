def fmt_pct(v):
    return f"{int(round(v))}%"


def fmt_bal(v):
    v = int(round(v))
    return "Centre" if v == 0 else f"L {-v}" if v < 0 else f"R {v}"


def fmt_db(v):
    return f"{v:+.1f} dB" if abs(v) >= 0.05 else "0 dB"


class Scene:
    def __init__(self, host, page="outputs"):
        self.host = host
        self.cfg, self.rt = load_cfg(), load_rt()
        self.st = dict(sinks=[], srcs=[], cards=[], apps=[], recs=[], mods=[], info={}, default_sink="",
                       default_src="", clock={})
        self.page = page if page in PAGE_IDS else "outputs"
        self.scroll, self.scroll_s, self.content_h = {}, {}, {}
        self.hits, self.mx, self.my, self.active = [], -1, -1, None
        self.t = self.page_t = 0.0; self.dt = 0.033; self.nav_y = None; self.last_input = time.monotonic()
        self.info, self._info = None, None
        self.toast_msg, self.toast_t = "", -10.0
        self.dialog, self.dialog_t, self.modal = None, 0.0, False
        self.hold, self.pending, self.last_flush = {}, {}, 0.0
        self.anim, self.flashes, self.codecs, self.busy = {}, {}, {}, set()
        self.eq = EQEngine(self.rt); self.eq_resp, self.eq_sig = None, None
        self.eq_dirty, self.eq_push_at, self.cfg_dirty_at = False, 0.0, 0.0
        self.coop_due = 0.0
        self.an = Analyzer(); self.an.start()
        n = Analyzer.N
        self.sp, self.pk, self.lv = [[0.0] * n, [0.0] * n], [[0.0] * n, [0.0] * n], [0.0, 0.0]
        self.tone_i, self.test_dev, self.rt_read = 3, 0, 0.0
        self.refreshing = False; self.refresh_due = 0.0; self.clock_due = 0.0
        self.clip = (0, 0, 99999, 99999)
        self.refresh()

    # ── state ──
    def refresh(self):
        if self.refreshing:
            self.refresh_again = True   # a snapshot is already running; it may predate the change, so go again
            return
        self.refreshing = True; self.refresh_again = False
        POOL.submit(lambda: self.host.idle(lambda st=snapshot(): self.apply(st)))

    def apply(self, st):
        self.refreshing = False; self.st = st
        if getattr(self, "refresh_again", False):
            self.refresh_again = False; self.refresh_due = self.t + 0.05
        if not self.cfg_dirty_at and "coop" not in self.busy and not self.coop_due and not DEMO:
            saved = load_cfg()
            for key in ("coop", "coop_devices", "coop_sync"):
                self.cfg[key] = saved[key]
            latest = load_rt()
            for key in list(self.rt):
                if key.startswith("coop_"):
                    self.rt.pop(key, None)
            self.rt.update({k: v for k, v in latest.items() if k.startswith("coop_")})
        for c in st["cards"]:
            if c["bluez"] and c["name"] not in self.codecs:
                self.codecs[c["name"]] = None
                POOL.submit(lambda n=c["name"]: self.host.idle(lambda r=bt_codecs(n): self.codecs.__setitem__(n, r)))

    def on_event(self):
        self.refresh_due = self.t + 0.09

    def alive(self, mk):
        if mk == "coop_mod" and not DEMO:
            return bool(coop_module(self.st))
        return (mk in self.rt) if DEMO else mod_alive(self.st, self.rt.get(mk))

    def hv(self, key, real):
        h = self.hold.get(key)
        return h[0] if h and (DEMO or time.monotonic() < h[1]) else real

    def sethold(self, key, v, secs=0.9):
        self.hold[key] = (v, time.monotonic() + secs)

    def queue(self, key, cmd):
        self.pending[key] = cmd

    def do(self, cmd, msg=None, refresh=True):
        def job():
            ok = run(cmd)
            self.host.idle(lambda: (self.toast(msg if ok else "The server said no") if msg else None,
                                    self.on_event() if refresh else None))
        COMMANDS.submit(job)

    toast_t_wall = -100.0

    def toast(self, msg):
        self.toast_msg, self.toast_t = msg, self.t; self.toast_t_wall = time.monotonic()

    def save(self):
        self.cfg_dirty_at = self.t + 0.4

    def goto(self, page):
        if page != self.page:
            self.page, self.page_t = page, 0.0

    def ask(self, title, msg, ok, on_ok):
        self.dialog = dict(title=title, msg=msg, ok=ok, on_ok=on_ok); self.dialog_t = self.t

    # ── input ──
    def _top(self, x, y, need=None):
        for h in reversed(self.hits):
            if self.dialog and not h.get("modal"):
                continue
            rx, ry, rw, rh = h["r"]
            if rx <= x < rx + rw and ry <= y < ry + rh and (need is None or need in h):
                return h
        return None

    def on_motion(self, x, y):
        self.mx, self.my = x, y; self.last_input = time.monotonic()
        if self.active and "drag" in self.active:
            self.active["drag"](x, y)

    def on_leave(self):
        if not self.active:
            self.mx = self.my = -1

    def on_press(self, x, y, button=1):
        self.mx, self.my = x, y; self.last_input = time.monotonic()
        h = self._top(x, y)
        if not h:
            if self.dialog:
                self.dialog = None
            return None
        if button == 3:
            if "alt" in h:
                h["alt"]()
            return None
        if button != 1:
            return None
        if "press" in h:
            h["press"](x, y)
        if "drag" in h:
            self.active = h
        return h.get("ret")

    def on_release(self, x, y):
        if self.active and "release" in self.active:
            self.active["release"]()
        self.active = None

    def on_scroll(self, x, y, dy):
        self.last_input = time.monotonic()
        h = self._top(x, y, "scroll")
        if h:
            h["scroll"](-1 if dy > 0 else 1); return
        if not self.dialog:
            cx, cy, cw, ch = self.view
            if cx <= x < cx + cw and cy <= y < cy + ch:
                self.scroll[self.page] = self.scroll.get(self.page, 0) + dy * 60

    def on_key(self, k):
        self.last_input = time.monotonic()
        if k == "Escape":
            if self.dialog:
                self.dialog = None
            else:
                self.host.close()
        elif k in ("Return", "KP_Enter") and self.dialog:
            d = self.dialog; self.dialog = None; d["on_ok"]()
        elif k in ("Page_Down", "Next"):
            self.scroll[self.page] = self.scroll.get(self.page, 0) + 300
        elif k in ("Page_Up", "Prior"):
            self.scroll[self.page] = self.scroll.get(self.page, 0) - 300
        elif k in ("Tab", "Down") and not self.dialog:
            self.goto(PAGE_IDS[(PAGE_IDS.index(self.page) + 1) % len(PAGE_IDS)])
        elif k in ("ISO_Left_Tab", "Up") and not self.dialog:
            self.goto(PAGE_IDS[(PAGE_IDS.index(self.page) - 1) % len(PAGE_IDS)])
        elif len(k) == 1 and k.isdigit() and 1 <= int(k) <= len(PAGE_IDS):
            self.goto(PAGE_IDS[int(k) - 1])

    # ── per-frame ──
    def tick(self, dt):
        self.dt = dt; self.t += dt; self.page_t += dt
        now = time.monotonic()
        if self.pending and now - self.last_flush > 0.045:
            for cmd in self.pending.values():
                COMMANDS.submit(run, cmd)
            self.pending.clear(); self.last_flush = now
        if self.refresh_due and self.t >= self.refresh_due:
            self.refresh_due = 0.0; self.refresh()
        if self.page == "engine" and self.t >= self.clock_due:
            self.clock_due = self.t + 2.5
            POOL.submit(lambda: self.host.idle(lambda c=clock_settings(): self.st.__setitem__("clock", c) if not DEMO else None))
        if self.cfg_dirty_at and self.t >= self.cfg_dirty_at:
            self.cfg_dirty_at = 0.0; save_cfg(self.cfg)
        if self.coop_due and self.t >= self.coop_due and "coop" not in self.busy:
            self.coop_due = 0.0; self.coop_rebuild()
        if self.eq_dirty and self.t >= self.eq_push_at:
            self.eq_dirty = False; eq = json.loads(json.dumps(self.cfg["eq"])); st = self.st
            POOL.submit(lambda: self.eq.update(eq, st))
        if self.t - self.rt_read > 1.0 and self.page == "night" and not DEMO:
            self.rt_read = self.t; night = load_rt().get("night")
            if night:
                self.rt["night"] = night
            else:
                self.rt.pop("night", None)
        # analyzer follows the page
        self.an.want = True
        self.an.bands_on = self.page == "astro"
        self.an.target = "mic" if self.page == "inputs" else ("mic" if self.page == "astro" and self.cfg["astro"]["source"] == "mic" else "out")
        decay = SMOOTH[self.cfg["astro"]["smooth"]][1]
        for s in (0, 1):
            src = self.an.L if s == 0 else self.an.R
            for i in range(Analyzer.N):
                v = src[i]; cur = self.sp[s][i]
                self.sp[s][i] = v if v > cur else max(v, cur - dt * decay * 0.25)
                self.pk[s][i] = max(self.sp[s][i], self.pk[s][i] - dt * 0.32)
            self.lv[s] += (self.an.lv[s] - self.lv[s]) * min(1.0, dt * 16)
        sc = self.scroll.get(self.page, 0)
        mx = max(0, self.content_h.get(self.page, 0) - getattr(self, "view", (0, 0, 0, 500))[3] + 24)
        sc = max(0, min(mx, sc)); self.scroll[self.page] = sc
        cur = self.scroll_s.get(self.page, 0)
        self.scroll_s[self.page] = cur + (sc - cur) * min(1.0, dt * 14)

    def close(self):
        self.an.close()
        for cmd in self.pending.values():
            COMMANDS.submit(run, cmd)
        self.pending.clear()
        if self.cfg_dirty_at:
            save_cfg(self.cfg)
        save_rt(self.rt)

    # ── primitive widgets ──
    def over(self, x, y, w, h):
        if self.dialog and not self.modal:
            return False
        cx, cy, cw, ch = self.clip
        return x <= self.mx < x + w and y <= self.my < y + h and cx <= self.mx < cx + cw and cy <= self.my < cy + ch

    def hit(self, id, x, y, w, h, **kw):
        cx, cy, cw, ch = self.clip
        x0, y0, x1, y1 = max(x, cx), max(y, cy), min(x + w, cx + cw), min(y + h, cy + ch)
        if x1 <= x0 or y1 <= y0:
            return
        if self.modal:
            kw["modal"] = True
        self.hits.append(dict(id=id, r=(x0, y0, x1 - x0, y1 - y0), **kw))

    def is_active(self, id):
        return bool(self.active) and self.active["id"] == id

    def lerp_anim(self, id, target, speed=14):
        a = self.anim.get(id, target); a += (target - a) * min(1.0, self.dt * speed); self.anim[id] = a
        return a

    def section(self, y, title, right=""):
        cr, x, w = self.cr, self.CX0, self.RW
        y += 16; cy = y + 12
        diamond(cr, x + 7, cy, 5); A(cr, GOLD); cr.fill()
        diamond(cr, x + 7, cy, 2); A(cr, DEEP); cr.fill()
        tw = text(cr, title, x + 22, cy, 17, GOLD_HI, bold=True)
        rw = text(cr, right, x + w, cy, 13, IVORY, 0.55, anchor="r", width=w * 0.45) if right else 0
        x0, x1 = x + 22 + tw + 14, x + w - (rw + 14 if rw else 0)
        if x1 > x0:
            g = cairo.LinearGradient(x0, 0, x1, 0)
            g.add_color_stop_rgba(0, GOLD[0], GOLD[1], GOLD[2], 0.7); g.add_color_stop_rgba(1, GOLD[0], GOLD[1], GOLD[2], 0.0)
            cr.set_source(g); cr.set_line_width(1); cr.move_to(x0, cy); cr.line_to(x1, cy); cr.stroke()
        return y + 40

    def row(self, y, title, sub=None, info=None, el=None, h=56, cw=None):
        cr, x, w = self.cr, self.CX0, self.RW
        hov = self.over(x, y, w, h)
        if hov and info:
            self._info = (title, info, el)
        rrect(cr, x, y, w, h, 9)
        if hov:
            g = cairo.LinearGradient(x, 0, x + w, 0)
            g.add_color_stop_rgba(0, GOLD[0], GOLD[1], GOLD[2], 0.20); g.add_color_stop_rgba(1, GOLD[0], GOLD[1], GOLD[2], 0.05)
            cr.set_source(g)
        else:
            A(cr, NAVY2, 0.55)
        cr.fill_preserve(); A(cr, GOLD, 0.55 if hov else 0.12); cr.set_line_width(1); cr.stroke()
        cy = y + h / 2
        if hov:
            diamond(cr, x + 11, cy, 3.4); A(cr, el is not None and elc(el) or GOLD_HI); cr.fill()
        cw = cw or min(340, w * 0.54)
        if sub:
            text(cr, title, x + 24, cy - 9, 15, IVORY, bold=True, width=w - cw - 50)
            text(cr, sub, x + 24, cy + 11, 13, IVORY, 0.52, width=w - cw - 50)
        else:
            text(cr, title, x + 24, cy, 15, IVORY, bold=True, width=w - cw - 50)
        return x + w - cw - 18, x + w - 18, cy

    def selector(self, id, x0, x1, cy, label, prev, nxt, dim=False):
        cr = self.cr; h = 36; y = cy - h / 2; w = x1 - x0
        rrect(cr, x0, y, w, h, h / 2); A(cr, DEEP, 0.6); cr.fill_preserve(); A(cr, GOLD, 0.38); cr.set_line_width(1); cr.stroke()
        for side, ax, fn in ((-1, x0 + h / 2, prev), (1, x1 - h / 2, nxt)):
            hov = self.over(ax - h / 2, y, h, h)
            cr.new_path(); cr.arc(ax, cy, 13, 0, 2 * math.pi); A(cr, GOLD, 0.30 if hov else 0.10); cr.fill()
            cr.move_to(ax + 5 * side, cy); cr.line_to(ax - 3.5 * side, cy - 6); cr.line_to(ax - 3.5 * side, cy + 6); cr.close_path()
            A(cr, GOLD_HI if hov else GOLD); cr.fill()
            self.hit(f"{id}:{side}", ax - h / 2, y, h, h, press=lambda *_, f=fn: f(), scroll=lambda d, p=prev, n=nxt: (n if d > 0 else p)())
        text(cr, label, (x0 + x1) / 2, cy, 14, IVORY, 0.55 if dim else 1.0, bold=True, anchor="c", width=w - 84)
        self.hit(id, x0 + h, y, w - 2 * h, h, press=lambda *_: nxt(), scroll=lambda d: (nxt if d > 0 else prev)())

    def slider(self, id, x0, x1, cy, value, lo, hi, on_change, fmt=fmt_pct, step=1.0, mark=None, center=None,
               el=None, alt=None, muted=False):
        cr = self.cr; tx0, tx1 = x0 + 10, x1 - 66
        pos = lambda v: tx0 + (tx1 - tx0) * (max(lo, min(hi, v)) - lo) / (hi - lo)
        hov = self.over(x0, cy - 17, x1 - x0, 34) or self.is_active(id)
        cr.set_line_cap(cairo.LINE_CAP_ROUND)
        cr.set_line_width(4); A(cr, NAVY3, 0.9); cr.move_to(tx0, cy); cr.line_to(tx1, cy); cr.stroke()
        for q in range(5):
            diamond(cr, tx0 + (tx1 - tx0) * q / 4, cy, 2.1); A(cr, GOLD, 0.3); cr.fill()
        s0 = pos(center if center is not None else lo); xv = pos(value)
        c0, c1 = (MUTE_C, MUTE_C) if muted else ((mix(elc(el), DEEP, 0.3), elc(el)) if el is not None else (GOLD_LO, GOLD_HI))
        if abs(xv - s0) > 0.5:
            g = cairo.LinearGradient(min(s0, xv), 0, max(s0, xv) + 1, 0)
            g.add_color_stop_rgb(0, *c0); g.add_color_stop_rgb(1, *c1)
            cr.set_source(g); cr.move_to(s0, cy); cr.line_to(xv, cy); cr.stroke()
        if mark is not None and value > mark and not muted:
            xm = pos(mark); g = cairo.LinearGradient(xm, 0, xv + 1, 0)
            g.add_color_stop_rgb(0, *EL[0][1]); g.add_color_stop_rgb(1, *DANGER)
            cr.set_source(g); cr.set_line_width(4); cr.move_to(xm, cy); cr.line_to(xv, cy); cr.stroke()
        if mark is not None:
            xm = pos(mark); cr.set_line_width(1.4); A(cr, GOLD_HI, 0.7); cr.move_to(xm, cy - 9); cr.line_to(xm, cy + 9); cr.stroke()
        if center is not None:
            diamond(cr, pos(center), cy, 3.4); A(cr, GOLD_HI, 0.8); cr.fill()
        r = 9 if hov else 7.5
        diamond(cr, xv, cy, r + 2); A(cr, GOLD, 0.35 if not muted else 0.1); cr.fill()
        diamond(cr, xv, cy, r); A(cr, IVORY if not muted else MUTE_C); cr.fill_preserve()
        A(cr, GOLD_LO); cr.set_line_width(1.4); cr.stroke()
        diamond(cr, xv, cy, 2.4); A(cr, INK); cr.fill()
        over_c = DANGER if (mark is not None and value > mark) else GOLD_HI
        text(cr, fmt(value), x1, cy, 14, over_c if not muted else MUTE_C, bold=True, anchor="r")

        def setv(mx, my):
            v = lo + (mx - tx0) / (tx1 - tx0) * (hi - lo)
            on_change(max(lo, min(hi, round(v / step) * step)))
        self.hit(id, x0, cy - 17, x1 - x0, 34, press=setv, drag=setv, alt=alt,
                 scroll=lambda d: on_change(max(lo, min(hi, round((value + d * step * (1 if step >= 1 else 1)) / step) * step))))

    def toggle(self, id, x1, cy, on, cb, busy=False):
        cr = self.cr; w, h = 62, 30; x = x1 - w; y = cy - h / 2
        a = self.lerp_anim(id, 1.0 if on else 0.0)
        hov = self.over(x - 80, y, w + 80, h)
        rrect(cr, x, y, w, h, h / 2)
        g = cairo.LinearGradient(x, 0, x + w, 0)
        c0, c1 = mix(NAVY3, GOLD_LO, a), mix(NAVY3, GOLD, a)
        g.add_color_stop_rgb(0, *c0); g.add_color_stop_rgb(1, *c1); cr.set_source(g); cr.fill_preserve()
        A(cr, GOLD, 0.9 if hov else 0.55); cr.set_line_width(1.2); cr.stroke()
        kx = x + h / 2 + a * (w - h)
        cr.new_path(); cr.arc(kx, cy, h / 2 - 4, 0, 2 * math.pi); A(cr, mix(MUTE_C, IVORY, a)); cr.fill()
        star(cr, kx, cy, 6.5 * a + 0.01, 0.25, self.t * 0.8 if busy else 0); A(cr, INK, a); cr.fill()
        lab = "Casting…" if busy else ("On" if on else "Off")
        text(cr, lab, x - 12, cy, 14, GOLD_HI if on else IVORY, 1.0 if on else 0.5, bold=on, anchor="r")
        self.hit(id, x - 80, y, w + 80, h, press=lambda *_: cb() if not busy else None)

    def gbutton(self, id, x, y, w, h, label, cb, glyph="o", dark=False, enabled=True):
        cr = self.cr; hov = enabled and self.over(x, y, w, h)
        fl = max(0.0, 1 - (self.t - self.flashes.get(id, -9)) / 0.25)
        if hov:
            rrect(cr, x - 3, y - 3, w + 6, h + 6, h / 2 + 3); A(cr, GOLD, 0.55); cr.set_line_width(2); cr.stroke()
        rrect(cr, x, y, w, h, h / 2)
        if dark:
            A(cr, mix(NAVY3, GOLD, 0.22 if hov else 0.0))
        else:
            A(cr, GOLD_HI if hov else IVORY)
        cr.fill_preserve(); A(cr, GOLD_LO, 0.8); cr.set_line_width(1); cr.stroke()
        if fl > 0:
            rrect(cr, x, y, w, h, h / 2); A(cr, (1, 1, 1), 0.35 * fl); cr.fill()
        r = h / 2 - 5; cx, cy = x + h / 2, y + h / 2
        cr.new_path(); cr.arc(cx, cy, r, 0, 2 * math.pi); A(cr, DEEP if dark else INK); cr.fill()
        if glyph == "o":
            cr.new_path(); cr.arc(cx, cy, r * 0.52, 0, 2 * math.pi); A(cr, O_YEL); cr.set_line_width(2.4); cr.stroke()
        elif glyph == "x":
            k = r * 0.42; A(cr, X_BLUE); cr.set_line_width(2.6); cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.move_to(cx - k, cy - k); cr.line_to(cx + k, cy + k); cr.move_to(cx + k, cy - k); cr.line_to(cx - k, cy + k); cr.stroke()
        elif glyph:
            icon(cr, glyph, cx, cy, r * 1.1, GOLD_HI)
        text(cr, label, x + h + (w - h - 14) / 2, cy, 14, IVORY if dark else INK, bold=True, anchor="c", width=w - h - 16)
        if not enabled:
            rrect(cr, x, y, w, h, h / 2); A(cr, DEEP, 0.5); cr.fill()
        else:
            self.hit(id, x, y, w, h, press=lambda *_: (self.flashes.__setitem__(id, self.t), cb()))

    def badge(self, x1, cy, label, col=IVORY, fg=INK):
        cr = self.cr; w = measure(cr, label, 13, True) + 44; h = 30; x = x1 - w
        rrect(cr, x, cy - h / 2, w, h, h / 2); A(cr, col); cr.fill()
        icon(cr, "check", x + 16, cy, 14, fg); text(cr, label, x + 28, cy, 13, fg, bold=True)
        return w

    def medal(self, cx, cy, r, kind=None, el=None, icons=None, letter="?", ring=False):
        cr = self.cr
        if ring and el is not None:
            g = cairo.RadialGradient(cx, cy, r * 0.6, cx, cy, r + 12); c = elc(el)
            g.add_color_stop_rgba(0, c[0], c[1], c[2], 0.35); g.add_color_stop_rgba(1, c[0], c[1], c[2], 0)
            cr.set_source(g); cr.new_path(); cr.arc(cx, cy, r + 12, 0, 2 * math.pi); cr.fill()
        cr.new_path(); cr.arc(cx, cy, r, 0, 2 * math.pi); A(cr, NAVY); cr.fill_preserve(); A(cr, GOLD); cr.set_line_width(1.6); cr.stroke()
        cr.new_path(); cr.arc(cx, cy, r - 4, 0, 2 * math.pi); A(cr, elc(el) if (ring and el is not None) else GOLD, 0.45); cr.set_line_width(1); cr.stroke()
        if icons and self.host.app_icon(cr, icons, cx, cy, int(r * 1.15)):
            return
        if kind:
            icon(cr, kind, cx, cy, r * 0.95, GOLD_HI)
        else:
            text(cr, letter, cx, cy, r * 0.8, GOLD_HI, bold=True, anchor="c")

    def card(self, y, title, sub, kind=None, el=None, icons=None, letter=None, current=False, right=None, h=74):
        cr, x, w = self.cr, self.CX0, self.RW
        rrect(cr, x, y, w, h, 12)
        g = cairo.LinearGradient(0, y, 0, y + h); g.add_color_stop_rgb(0, *NAVY3); g.add_color_stop_rgb(1, *NAVY2)
        cr.set_source(g); cr.fill_preserve(); A(cr, GOLD, 0.95 if current else 0.45); cr.set_line_width(1.3 if current else 1); cr.stroke()
        if current:
            rrect(cr, x + 4, y + 4, w - 8, h - 8, 9); A(cr, elc(el), 0.35); cr.set_line_width(1); cr.stroke()
        cy = y + h / 2
        self.medal(x + 40, cy, 24, kind, el, icons, letter or (title[:1] or "?").upper(), ring=current)
        rw = 190
        text(cr, title, x + 78, cy - 11, 17, IVORY, bold=True, width=w - 78 - rw)
        text(cr, sub, x + 78, cy + 12, 13, GOLD, 0.9, width=w - 78 - rw)
        if right:
            right(x + w - 18, cy)
        return y + h + 8

    def empty(self, y, msg):
        cr, x, w = self.cr, self.CX0, self.RW
        rrect(cr, x, y, w, 70, 12); A(cr, NAVY2, 0.35); cr.fill_preserve(); A(cr, GOLD, 0.2); cr.set_line_width(1)
        cr.set_dash([4, 5]); cr.stroke(); cr.set_dash([])
        star(cr, x + 34, y + 35, 10, 0.22, self.t * 0.4); A(cr, GOLD, 0.6); cr.fill()
        text(cr, msg, x + 56, y + 35, 14, IVORY, 0.6, width=w - 80)
        return y + 82

    # ── actions ──
    def mode(self, key, fn, mk):
        if key in self.busy:
            return
        want = not self.alive(mk); self.cfg[key] = want; self.save(); self.busy.add(key); st = self.st

        def job():
            msg = fn(want, self.rt, st); save_rt(self.rt)
            actual = bool(coop_module(snapshot())) if key == "coop" and not DEMO else (mk in self.rt)
            def done():
                self.cfg[key] = actual; self.save()
                self.busy.discard(key); self.toast(msg); self.refresh()
            self.host.idle(done)
        POOL.submit(job)

    def coop_has(self, name):
        sel = self.cfg["coop_devices"]
        return sel is None or name in sel

    def coop_pick(self, name):
        hw = [s["name"] for s in hw_sinks(self.st)]
        cur = self.cfg["coop_devices"]
        sel = list(hw if cur is None else cur)
        if name in sel:
            sel.remove(name)
        else:
            sel.append(name)
        self.cfg["coop_devices"] = sel; self.rt["coop_sel"] = sel
        self.save(); self.coop_due = self.t + 0.9

    def coop_sync_toggle(self):
        v = not self.cfg["coop_sync"]
        self.cfg["coop_sync"] = v; self.rt["coop_sync"] = v
        self.save(); self.coop_due = self.t + 0.5

    def coop_rebuild(self):
        if not self.alive("coop_mod"):
            return
        self.busy.add("coop"); st = self.st

        def job():
            msg = coop_reload(self.rt, st); save_rt(self.rt)

            def done():
                self.busy.discard("coop"); self.cfg["coop"] = "coop_mod" in self.rt
                self.save(); self.toast(msg); self.refresh()
            self.host.idle(done)
        POOL.submit(job)

    def set_default(self, kind, d):
        group = coop_module(self.st) if kind == "sink" else None
        if group and f"sink_name={d['name']}" not in group["arg"].split():
            self.toast("Co-op is active: change members in Co-op Circle, or turn it off first")
            return
        def job():
            ok = run(["pactl", f"set-default-{kind}", d["name"]])
            if ok and kind == "sink" and self.cfg["follow_streams"]:
                ok = not move_all(self.st, d["name"])
            self.host.idle(lambda: (self.toast(f"Now using {d['desc']}" if ok else "Could not switch every stream"), self.on_event()))
        COMMANDS.submit(job)

    def level(self, kind, ident, ch, vol, bal, key):
        self.queue(key, ["pactl", f"set-{kind}-volume", str(ident)] + chan_values(ch, vol, bal))

    def eq_set(self, i, g):
        eq = self.cfg["eq"]; eq["gains"][i] = g; eq["preset"] = "Custom"; self.eq_changed()

    def eq_changed(self):
        self.eq_dirty = True; self.eq_push_at = self.t + 0.12; self.save()

    def eq_toggle(self):
        if "eq" in self.busy:
            return
        on = not self.eq.running(); self.cfg["eq"]["enabled"] = on; self.save(); self.busy.add("eq")
        eq, st = json.loads(json.dumps(self.cfg["eq"])), self.st

        def job():
            msg = self.eq.start(eq, st) if on else self.eq.stop(st); save_rt(self.rt)
            self.host.idle(lambda: (self.busy.discard("eq"), self.toast(msg), self.refresh()))
        POOL.submit(job)

    def eq_restart(self):
        if self.eq.running():
            eq, st = json.loads(json.dumps(self.cfg["eq"])), self.st
            POOL.submit(lambda: (self.eq.start(eq, st), save_rt(self.rt)))

    def night_start(self):
        n = self.cfg["night"]
        if DEMO:
            self.rt["night"] = dict(pid=0, start=time.time() - 400, dur=n["minutes"] * 60, v0=64, action=n["action"], curve=n["curve"])
        else:
            try:
                subprocess.Popen([sys.executable, SELF, "--night-watch", str(n["minutes"]), str(n["curve"]), str(n["action"])],
                                 start_new_session=True, env=clean_env(), stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                self.toast("Could not start the watch"); return
            self.rt_read = self.t - 0.5
        self.toast(f"Paimon will keep watch for {n['minutes']} minutes")

    def night_stop(self):
        night = self.rt.pop("night", None)
        if night and night.get("pid") and not DEMO:
            try:
                os.kill(int(night["pid"]), signal.SIGTERM)
            except Exception:
                pass
        self.toast("The watch has ended, volume restored")

    def open_mixer(self):
        sib = os.path.join(os.path.dirname(SELF), "irminsul-volume")
        for cmd in ([sib] if os.access(sib, os.X_OK) else []) + ["irminsul-volume"]:
            try:
                subprocess.Popen([cmd], start_new_session=True, env=clean_env()); return
            except Exception:
                continue
        self.toast("irminsul-volume was not found on PATH")

    # ── shared blocks ──
    def dev_block(self, y, d, kind, is_def, el):
        k = kind; name = d["name"]
        sub = "  ·  ".join(x for x in (d["spec"], d["state"], d["api"]) if x)

        def right(x1, cy):
            if is_def:
                self.badge(x1, cy, "In use")
            else:
                self.gbutton(f"def:{name}", x1 - 176, cy - 20, 176, 40, "Set as default", lambda: self.set_default(k, d))
        y = self.card(y, d["desc"], sub, kind=d["kind"] if k == "sink" else "mic", el=el, current=is_def, right=right)
        if d["ports"]:
            names = [p[0] for p in d["ports"]]; i = names.index(d["port"]) if d["port"] in names else 0
            lab = lambda p: p[1] + ("  (unplugged)" if p[2] in ("not available", "no") else "")

            def setp(j):
                p = d["ports"][j % len(names)]
                self.do(["pactl", f"set-{k}-port", name, p[0]], f"Port: {p[1]}")
            x0, x1, cy = self.row(y, "Port", f"{len(names)} connector{'s' if len(names) != 1 else ''}", el=el,
                                  info="The physical connector this device uses. Switch between speakers and the "
                                       "headphone jack, or line-in and the front mic, without replugging anything.")
            self.selector(f"port:{name}", x0, x1, cy, lab(d["ports"][i]), lambda: setp(i - 1), lambda: setp(i + 1))
            y += 62
        kv, kb, km, kl = f"v:{k}:{name}", f"b:{k}:{name}", f"m:{k}:{name}", f"lvl:{k}:{name}"
        vol, bal, mute = self.hv(kv, d["vol"]), self.hv(kb, d["bal"]), self.hv(km, d["mute"])
        lim = self.cfg["boost_limit"]

        def setv(v):
            self.sethold(kv, v); self.level(k, name, d["ch"], v, self.hv(kb, d["bal"]), kl)

        def setb(b):
            self.sethold(kb, b); self.level(k, name, d["ch"], self.hv(kv, d["vol"]), b, kl)
        x0, x1, cy = self.row(y, "Volume", "Past 100 % is overdrive", el=el,
                              info=f"Software gain up to {lim} %. Anything past the bright tick is amplified "
                                   "beyond the device's own maximum: great for quiet recordings, but it can clip. "
                                   "Right-click to snap back to 100 %.")
        self.slider(kv, x0, x1, cy, vol, 0, lim, setv, mark=100, el=el if k == "source" else None, muted=mute,
                    alt=lambda: setv(100))
        y += 62
        if len(d["ch"]) >= 2:
            x0, x1, cy = self.row(y, "Balance", ", ".join(c.replace("front-", "").replace("-", " ") for c, _ in d["ch"][:4]), el=el,
                                  info="Shift the sound between the left and right channels. Perfect for a headset "
                                       "where one side is weaker, or speakers that sit at different distances. "
                                       "Right-click to centre.")
            self.slider(kb, x0, x1, cy, bal, -100, 100, setb, fmt=fmt_bal, center=0, el=el, alt=lambda: setb(0))
            y += 62
        x0, x1, cy = self.row(y, "Mute", el=el, info="Silence this device without touching its volume.")
        self.toggle(km, x1, cy, mute, lambda: (self.sethold(km, not mute), self.do(["pactl", f"set-{k}-mute", name, "toggle"])))
        y += 62
        if k == "sink":
            sus = d["state"] == "Suspended"
            x0, x1, cy = self.row(y, "Suspend", "Close the device to save power", el=el,
                                  info="Puts the hardware to sleep. Useful to release an HDMI output, stop a "
                                       "humming amplifier, or free the device for another program. Any new sound wakes it.")
            self.toggle(f"sus:{name}", x1, cy, sus,
                        lambda: self.do(["pactl", "suspend-sink", name, "0" if sus else "1"], "Device woken" if sus else "Device sleeping"))
            y += 62
        return y + 16

    def info_row(self, y, title, value, sub=None, info=None, el=None):
        x0, x1, cy = self.row(y, title, sub, info=info, el=el)
        text(self.cr, value or "—", x1, cy, 14, GOLD_HI, bold=True, anchor="r", width=x1 - x0)
        return y + 62

