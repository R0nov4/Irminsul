def _merge(base, over):
    out = json.loads(json.dumps(base))
    for k, v in (over or {}).items():
        if isinstance(v, dict) and isinstance(out.get(k), dict):
            out[k] = _merge(out[k], v)
        else:
            out[k] = v
    return out


def load_cfg():
    try:
        with open(CFG_PATH) as f:
            return _merge(DEFAULTS, json.load(f))
    except Exception:
        return _merge(DEFAULTS, {})


def save_cfg(cfg):
    if DEMO:
        return
    try:
        os.makedirs(CFG_DIR, exist_ok=True)
        tmp = CFG_PATH + ".tmp"
        with open(tmp, "w") as f:
            json.dump(cfg, f, indent=2)
        os.replace(tmp, CFG_PATH)
    except Exception:
        pass


def load_rt():
    try:
        with open(RT_PATH) as f:
            return json.load(f)
    except Exception:
        return {}


def save_rt(rt):
    if DEMO:
        return
    try:
        with open(RT_PATH, "w") as f:
            json.dump(rt, f)
    except Exception:
        pass


# ───────────────────────────── palette ─────────────────────────────
def hx(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))


def mix(a, b, t):
    return tuple(a[i] * (1 - t) + b[i] * t for i in range(3))


GOLD, GOLD_HI, GOLD_LO = hx("D3BC8E"), hx("F3E7C4"), hx("A38B5A")
IVORY, INK = hx("ECE5D8"), hx("3B4255")
NAVY, NAVY2, NAVY3 = hx("2B3042"), hx("383E54"), hx("4A5169")
DEEP = hx("1B1E2B")
MUTE_C, DANGER = hx("8A8D99"), hx("E5675A")
O_YEL, X_BLUE = hx("F2C14E"), hx("4F8FD9")
ELEMENTS = [("Pyro", "EF7938"), ("Hydro", "33BEFF"), ("Anemo", "66E6BD"), ("Electro", "B58AE0"),
            ("Dendro", "A5C83B"), ("Cryo", "98C8E8"), ("Geo", "F8BA4E")]
EL = [(n, hx(c)) for n, c in ELEMENTS]
FONT = "HYWenHei-85W,SDK_SC_Web,Noto Sans,Sans"


def elc(i):
    return GOLD if i is None or i < 0 else EL[i % 7][1]


def el_grad(t):
    """Colour along the seven elements, t in 0..1 (Pyro -> Geo order shuffled for a nice spectrum)."""
    seq = [EL[0][1], EL[6][1], EL[4][1], EL[2][1], EL[1][1], EL[5][1], EL[3][1]]
    t = max(0.0, min(0.9999, t)) * (len(seq) - 1)
    i = int(t)
    return mix(seq[i], seq[i + 1], t - i)


# ───────────────────────────── drawing helpers ─────────────────────────────
def A(cr, c, a=1.0):
    cr.set_source_rgba(c[0], c[1], c[2], a)


def rrect(cr, x, y, w, h, r):
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
    cr.close_path()


def diamond(cr, x, y, r):
    cr.move_to(x, y - r); cr.line_to(x + r, y); cr.line_to(x, y + r); cr.line_to(x - r, y); cr.close_path()


def star(cr, x, y, r, k=0.22, rot=0.0, n=4):
    for i in range(n * 2):
        rad = r if i % 2 == 0 else r * k
        a = rot + i * math.pi / n - math.pi / 2
        (cr.move_to if i == 0 else cr.line_to)(x + rad * math.cos(a), y + rad * math.sin(a))
    cr.close_path()


if PREVIEW:
    def _face(cr, size, bold):
        cr.select_font_face("DejaVu Sans", 0, 1 if bold else 0); cr.set_font_size(size * 0.92)

    def measure(cr, s, size, bold=False):
        _face(cr, size, bold); return cr.text_extents(s)[4]

    def text(cr, s, x, y, size, col, a=1.0, bold=False, anchor="l", width=None):
        _face(cr, size, bold)
        if width and cr.text_extents(s)[4] > width:
            while s and cr.text_extents(s + "…")[4] > width:
                s = s[:-1]
            s += "…"
        w = cr.text_extents(s)[4]
        ox = x - (w if anchor == "r" else w / 2 if anchor == "c" else 0)
        cr.move_to(ox, y + size * 0.34); A(cr, col, a); cr.show_text(s)
        return w

    def para(cr, s, x, y, size, col, a, width, lh=1.5):
        _face(cr, size, False); A(cr, col, a)
        line, yy = "", y + size
        for word in s.split(" "):
            t = (line + " " + word).strip()
            if cr.text_extents(t)[4] > width and line:
                cr.move_to(x, yy); cr.show_text(line); yy += size * lh; line = word
            else:
                line = t
        if line:
            cr.move_to(x, yy); cr.show_text(line); yy += size * lh
        return yy - y - size * 0.6
else:
    _LAY_CACHE = {}
    _FD_CACHE = {}

    def _layout(cr, s, size, bold, width=None, wrap=False):
        key = None if wrap else (s, size, bold, int(width) if width else 0)
        if key is not None:
            lay = _LAY_CACHE.get(key)
            if lay is not None:
                PangoCairo.update_layout(cr, lay)
                return lay
        lay = PangoCairo.create_layout(cr)
        fk = (size, bold)
        fd = _FD_CACHE.get(fk)
        if fd is None:
            fd = Pango.FontDescription(); fd.set_family(FONT)
            fd.set_absolute_size(size * Pango.SCALE)
            fd.set_weight(Pango.Weight.BOLD if bold else Pango.Weight.NORMAL)
            _FD_CACHE[fk] = fd
        lay.set_font_description(fd); lay.set_text(s, -1)
        if width:
            lay.set_width(int(width * Pango.SCALE))
            if wrap:
                lay.set_wrap(Pango.WrapMode.WORD_CHAR)
            else:
                lay.set_ellipsize(Pango.EllipsizeMode.END)
        if key is not None:
            if len(_LAY_CACHE) > 900:
                _LAY_CACHE.clear()
            _LAY_CACHE[key] = lay
        return lay

    def measure(cr, s, size, bold=False):
        return _layout(cr, s, size, bold).get_pixel_size()[0]

    def text(cr, s, x, y, size, col, a=1.0, bold=False, anchor="l", width=None):
        if "\n" in s:
            s = " ".join(s.split())
        lay = _layout(cr, s, size, bold, width)
        w, h = lay.get_pixel_size()
        ox = x - (w if anchor == "r" else w / 2 if anchor == "c" else 0)
        cr.move_to(ox, y - h / 2); A(cr, col, a); PangoCairo.show_layout(cr, lay)
        return w

    def para(cr, s, x, y, size, col, a, width, lh=1.5):
        lay = _layout(cr, s, size, False, width, wrap=True)
        try:
            lay.set_line_spacing(lh * 0.86)
        except Exception:
            pass
        cr.move_to(x, y); A(cr, col, a); PangoCairo.show_layout(cr, lay)
        return lay.get_pixel_size()[1]


def icon(cr, kind, x, y, s, col, a=1.0, muted=False):
    """Vector icons on a 24-unit grid centred on (x, y)."""
    cr.save(); cr.translate(x, y); cr.scale(s / 24.0, s / 24.0)
    A(cr, col, a); cr.set_line_cap(cairo.LINE_CAP_ROUND); cr.set_line_join(cairo.LINE_JOIN_ROUND)
    cr.set_line_width(2.2)
    if kind == "speaker":
        cr.move_to(-10, -4); cr.line_to(-5, -4); cr.line_to(1, -9); cr.line_to(1, 9)
        cr.line_to(-5, 4); cr.line_to(-10, 4); cr.close_path(); cr.fill()
        if not muted:
            for r in (5.5, 10):
                cr.new_path(); cr.arc(1, 0, r, -0.85, 0.85); cr.stroke()
        else:
            A(cr, DANGER, a); cr.set_line_width(2.4)
            cr.move_to(6, -4.5); cr.line_to(12, 4.5); cr.move_to(12, -4.5); cr.line_to(6, 4.5); cr.stroke()
    elif kind == "mic":
        rrect(cr, -3.8, -11, 7.6, 14, 3.8); cr.fill()
        cr.new_path(); cr.arc(0, -1, 7.5, 0, math.pi); cr.stroke()
        cr.move_to(0, 6.5); cr.line_to(0, 11); cr.move_to(-4, 11); cr.line_to(4, 11); cr.stroke()
    elif kind == "headphones":
        cr.set_line_width(2.4); cr.new_path(); cr.arc(0, 1, 8.5, math.pi, 2 * math.pi); cr.stroke()
        rrect(cr, -11, 1, 5.5, 10, 2.2); cr.fill(); rrect(cr, 5.5, 1, 5.5, 10, 2.2); cr.fill()
    elif kind == "monitor":
        rrect(cr, -10.5, -8.5, 21, 14, 2.2); cr.stroke()
        cr.move_to(0, 6); cr.line_to(0, 10); cr.move_to(-5, 10.5); cr.line_to(5, 10.5); cr.stroke()
    elif kind == "close":
        cr.move_to(-6, -6); cr.line_to(6, 6); cr.move_to(6, -6); cr.line_to(-6, 6); cr.stroke()
    elif kind == "party":
        for dx, r, yy in ((-7, 3.2, -3), (7, 3.2, -3), (0, 4, -5)):
            cr.new_path(); cr.arc(dx, yy, r, 0, 2 * math.pi); cr.fill()
        for dx, w in ((-7, 5.5), (7, 5.5)):
            cr.new_path(); cr.arc(dx, 7, w, math.pi, 2 * math.pi); cr.fill()
        cr.new_path(); cr.arc(0, 8, 7, math.pi, 2 * math.pi); A(cr, col, a); cr.fill()
    elif kind == "card":
        rrect(cr, -9, -9, 18, 18, 3); cr.stroke()
        rrect(cr, -4, -4, 8, 8, 1.5); cr.fill()
        for k in (-5, 0, 5):
            for (x0, y0, x1, y1) in ((k, -9, k, -12), (k, 9, k, 12), (-9, k, -12, k), (9, k, 12, k)):
                cr.move_to(x0, y0); cr.line_to(x1, y1)
        cr.stroke()
    elif kind == "eq":
        for i, (xx, kn) in enumerate(((-7, 3), (0, -4), (7, 1))):
            cr.move_to(xx, -10); cr.line_to(xx, 10); cr.stroke()
            diamond(cr, xx, kn, 3.6); cr.fill()
    elif kind == "astro":
        cr.new_path(); cr.arc(0, 0, 9.5, 0, 2 * math.pi); cr.stroke()
        star(cr, 0, 0, 8, 0.25); cr.fill()
        cr.set_line_width(1.4); cr.new_path(); cr.arc(0, 0, 4, 0, 2 * math.pi); A(cr, NAVY, a); cr.fill()
    elif kind in ("engine", "gear"):
        n = 8 if kind == "gear" else 6
        for i in range(n):
            ang = i * 2 * math.pi / n
            cr.save(); cr.rotate(ang); rrect(cr, -2.4, -11.5, 4.8, 6, 1); cr.fill(); cr.restore()
        cr.new_path(); cr.arc(0, 0, 7.5, 0, 2 * math.pi); cr.set_line_width(3.4); cr.stroke()
        if kind == "engine":
            star(cr, 0, 0, 3.5, 0.3); cr.fill()
    elif kind == "moon":
        cr.new_path(); cr.arc(0, 0, 10, 0, 2 * math.pi); cr.new_sub_path()
        cr.arc_negative(5, -4, 8.5, 2 * math.pi, 0); cr.set_fill_rule(cairo.FILL_RULE_EVEN_ODD); cr.fill()
        cr.set_fill_rule(cairo.FILL_RULE_WINDING)
        star(cr, 6, 5, 3.4, 0.25); cr.fill()
    elif kind == "play":
        cr.move_to(-5, -8); cr.line_to(8, 0); cr.line_to(-5, 8); cr.close_path(); cr.fill()
    elif kind == "stop":
        rrect(cr, -7, -7, 14, 14, 2); cr.fill()
    elif kind == "bt":
        cr.move_to(-6, -6); cr.line_to(6, 6); cr.line_to(0, 11); cr.line_to(0, -11); cr.line_to(6, -6); cr.line_to(-6, 6)
        cr.stroke()
    elif kind == "wave":
        cr.move_to(-11, 0)
        for i in range(23):
            xx = -11 + i
            cr.line_to(xx, math.sin(i * 0.8) * 7 * math.sin(i / 22 * math.pi))
        cr.stroke()
    elif kind == "restart":
        cr.new_path(); cr.arc(0, 0, 8.5, -0.3, 1.5 * math.pi + 0.2); cr.stroke()
        cr.move_to(1, -12.5); cr.line_to(5, -8.5); cr.line_to(0.5, -5.5); cr.close_path(); cr.fill()
    elif kind == "check":
        cr.move_to(-8, 0); cr.line_to(-2, 6); cr.line_to(9, -6); cr.stroke()
    if muted and kind in ("mic", "headphones", "monitor"):
        A(cr, DANGER, a); cr.set_line_width(2.6); cr.move_to(-10, 10); cr.line_to(10, -10); cr.stroke()
    cr.restore()


# ───────────────────────────── audio backend ─────────────────────────────
def clean_env():
    env = dict(os.environ)
    env.pop("IRMINSUL_NO_REEXEC", None)
    pre = [x for x in env.get("LD_PRELOAD", "").split(":") if x and "gtk-layer-shell" not in x]
    if pre:
        env["LD_PRELOAD"] = ":".join(pre)
    else:
        env.pop("LD_PRELOAD", None)
    return env


def sh(*cmd, timeout=3):
    if DEMO:
        return ""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def run(cmd):
    if DEMO:
        return True
    try:
        return subprocess.run(cmd, capture_output=True, timeout=6).returncode == 0
    except Exception:
        return False


def pj(*args):
    try:
        return json.loads(sh("pactl", "--format=json", *args))
    except Exception:
        return [] if args[0] == "list" else {}


def chan_list(d):
    vol = d.get("volume") or {}
    return [(k, v.get("value", 0) / 65536 * 100) for k, v in vol.items()]


def vol_of(ch):
    return round(max([v for _, v in ch] or [0]))


def bal_of(ch):
    L = [v for k, v in ch if "left" in k]; R = [v for k, v in ch if "right" in k]
    if not L or not R:
        return 0
    l, r = sum(L) / len(L), sum(R) / len(R); m = max(l, r)
    return 0 if m <= 0 else round((r - l) / m * 100)


def chan_values(ch, vol, bal):
    """Per-channel percentages for a target volume and balance (-100 left ... +100 right)."""
    out = []
    for k, _ in (ch or [("mono", 0)]):
        v = vol
        if "left" in k:
            v *= 1 - max(0, bal) / 100
        elif "right" in k:
            v *= 1 + min(0, bal) / 100
        out.append(f"{max(0, int(round(v)))}%")
    return out


def kind_of(d):
    p = d.get("properties", {})
    ff, n, port = p.get("device.form_factor", "").lower(), d["name"].lower(), (d.get("active_port") or "").lower()
    if "hdmi" in n or "hdmi" in port or "displayport" in port:
        return "monitor"
    if ff in ("headphone", "headset", "hands-free", "handsfree") or "headphone" in port or "headset" in port or "bluez" in n:
        return "headphones"
    return "speaker"


def _dev(d):
    ch = chan_list(d)
    ports = [(p.get("name"), p.get("description", p.get("name")), p.get("availability", "")) for p in d.get("ports", [])]
    p = d.get("properties", {})
    return dict(name=d["name"], idx=d.get("index"), desc=d.get("description") or d["name"], ch=ch, vol=vol_of(ch),
                bal=bal_of(ch), mute=bool(d.get("mute")), state=(d.get("state") or "").title(), ports=ports,
                port=d.get("active_port"), spec=d.get("sample_specification", ""), kind=kind_of(d),
                api=p.get("device.api", p.get("factory.name", "")), virtual=d["name"].startswith("irminsul") or
                d["name"].startswith("effect_input.irminsul"))


def snapshot():
    if DEMO:
        return demo_state()
    sinks = [_dev(s) for s in pj("list", "sinks")]
    srcs = [_dev(s) for s in pj("list", "sources") if not s["name"].endswith(".monitor")]
    cards = []
    for c in pj("list", "cards"):
        profs = [(n, p.get("description", n), bool(p.get("available", True)))
                 for n, p in (c.get("profiles") or {}).items()]
        cards.append(dict(name=c["name"], idx=c.get("index"), desc=(c.get("properties") or {}).get("device.description", c["name"]),
                          profiles=profs, active=c.get("active_profile"), bluez=c["name"].startswith("bluez")))
    apps = []
    for a in pj("list", "sink-inputs"):
        p = a.get("properties", {})
        name = p.get("application.name") or p.get("media.name") or "Unknown"
        if "irminsul" in name.lower() or internal_stream(a):
            continue
        icons = [p.get("application.icon_name"), (p.get("application.process.binary") or "").lower(), name.lower()]
        ch = chan_list(a)
        apps.append(dict(idx=a["index"], name=name, media=p.get("media.name", ""), icons=[i for i in icons if i],
                         ch=ch, vol=vol_of(ch), bal=bal_of(ch), mute=bool(a.get("mute")), sink=a.get("sink"),
                         corked=bool(a.get("corked"))))
    recs = []
    for r in pj("list", "source-outputs"):
        p = r.get("properties", {})
        name = p.get("application.name") or p.get("media.name") or "Unknown"
        if "irminsul" in name.lower() or name in ("parec", "PulseAudio Volume Control"):
            continue
        recs.append(dict(idx=r["index"], name=name, media=p.get("media.name", ""), src=r.get("source")))
    mods = [dict(idx=m.get("index"), name=m.get("name", ""), arg=" ".join((m.get("argument") or "").split())[:240]) for m in pj("list", "modules")]
    info = pj("info")
    return dict(sinks=sinks, srcs=srcs, cards=cards, apps=apps, recs=recs, mods=mods, info=info or {},
                default_sink=sh("pactl", "get-default-sink").strip(),
                default_src=sh("pactl", "get-default-source").strip(), clock=clock_settings())


def clock_settings():
    out = {}
    for line in sh("pw-metadata", "-n", "settings").splitlines():
        m = re.search(r"key:'([^']+)'\s+value:'([^']*)'", line)
        if m:
            out[m.group(1)] = m.group(2)
    return out


def bt_codecs(card):
    if DEMO:
        return [("sbc", "SBC"), ("aac", "AAC"), ("aptx_hd", "aptX HD"), ("ldac", "LDAC")], "ldac"
    path = f"/card/{card}/bluez"
    try:
        lst = json.loads(sh("pactl", "send-message", path, "list-codecs") or "[]")
        cur = json.loads(sh("pactl", "send-message", path, "get-codec") or '""')
        return [(c.get("name"), c.get("description", c.get("name"))) for c in lst], cur
    except Exception:
        return [], ""


def hw_sinks(st):
    return [s for s in st.get("sinks", []) if not s["virtual"]]


def load_module(*args):
    if DEMO:
        return random.randint(500, 900)
    out = sh("pactl", "load-module", *args).strip()
    return int(out) if out.isdigit() else None


def unload_module(idx):
    if idx is not None:
        run(["pactl", "unload-module", str(idx)])


def move_all(st, sink):
    """Move every real playback stream to `sink`. Returns the list of stream names that could not be moved.
    A stream that ended meanwhile, or is already there, is not a failure."""
    failed = []
    for a in st.get("apps", []):
        if internal_stream(a):
            continue
        cmd = ["pactl", "move-sink-input", str(a["idx"]), sink]
        if run(cmd):
            continue
        time.sleep(0.12)
        if run(cmd):
            continue
        if DEMO:
            continue
        sinks = {s["index"]: s["name"] for s in pj("list", "sinks")}
        live = {x["index"]: x for x in pj("list", "sink-inputs")}
        cur = live.get(a["idx"])
        if cur is None or sinks.get(cur.get("sink")) == sink:
            continue
        failed.append(a.get("name", "?"))
    return failed


def mod_alive(st, idx):
    return idx is not None and any(m["idx"] == idx for m in st.get("mods", []))


# ── resonance modes (each returns a short message for the toast) ──
def internal_stream(a):
    """Do not move server-side playback legs into their own input sink."""
    driver = str(a.get("driver", "")).lower()
    return any(k in driver for k in ("combine", "loopback", "remap", "filter")) or (
        a.get("client") is None and a.get("owner_module") is not None)


def _coop_sink_of(m):
    for tok in m.get("arg", "").split():
        if tok.startswith("sink_name=irminsul_coop"):
            return tok.split("=", 1)[1]
    return None


def coop_modules(st):
    """Every combine module we ever created (leaked ones included)."""
    return [m for m in st.get("mods", []) if m["name"] == "module-combine-sink" and _coop_sink_of(m)]


def coop_module(st):
    mods = coop_modules(st)
    return mods[0] if mods else None


def _short(*args):
    """Plain `pactl list short ...` lines, or None when pactl failed (unknown is NOT the same as empty)."""
    try:
        p = subprocess.run(["pactl", "list", "short", *args], capture_output=True, text=True, timeout=8)
    except Exception:
        return None
    return p.stdout.splitlines() if p.returncode == 0 else None


def coop_live():
    """(module ids, sink names) of every Co-op group, read straight from pactl without JSON or truncation.
    Returns None if the server could not be queried."""
    mods, sinks = _short("modules"), _short("sinks")
    if mods is None or sinks is None:
        return None
    ids = []
    for line in mods:
        f = line.split("\t")
        if len(f) >= 2 and f[1] == "module-combine-sink" and "irminsul_coop" in "\t".join(f[2:]) and f[0].isdigit():
            ids.append(int(f[0]))
    names = [l.split("\t")[1] for l in sinks if len(l.split("\t")) > 1 and l.split("\t")[1].startswith("irminsul_coop")]
    return ids, names


def unload_all_coop(keep=None):
    """Unload every Co-op module except `keep`. True only when pactl itself confirms they are gone."""
    if DEMO:
        return True
    for _ in range(8):
        live = coop_live()
        if live is None:                # server did not answer: unknown, never 'gone'
            time.sleep(0.3)
            continue
        ids, names = live
        left = [i for i in ids if i != keep]
        if not left and (keep is not None or not names):
            return True
        for i in left:
            run(["pactl", "unload-module", str(i)])
        time.sleep(0.3)
    live = coop_live()
    return bool(live) and not [i for i in live[0] if i != keep] and (keep is not None or not live[1])


def coop_opts(rt):
    """(selected sink names or None for 'every output', latency sync on/off)."""
    cfg = load_cfg()
    return (rt["coop_sel"] if "coop_sel" in rt else cfg["coop_devices"],
            rt["coop_sync"] if "coop_sync" in rt else cfg["coop_sync"])


def coop_members(st, sel):
    """Connected real outputs that take part in Co-op. sel=None means all of them."""
    names = [s["name"] for s in hw_sinks(st)]
    return names if sel is None else [n for n in names if n in sel]


def mode_coop(on, rt, st):
    """Build the replacement first, then switch; always remove every old/leaked group."""
    olds = coop_modules(st)
    old_names = {_coop_sink_of(m) for m in olds}
    old_sinks = [s for s in st["sinks"] if s["name"] in old_names]
    old_sink = next((s for s in old_sinks if s["name"] == st.get("default_sink")), old_sinks[0] if old_sinks else None)
    hardware = hw_sinks(st)
    names_hw = [s["name"] for s in hardware]
    if not on:
        live = None if DEMO else coop_live()
        if not olds and not old_sinks and (DEMO or (live is not None and not live[0] and not live[1])):
            for key in ("coop_mod", "coop_sink", "coop_prev", "coop_members"):
                rt.pop(key, None)
            return "Co-op ended"
        prev = rt.get("coop_prev")
        target = prev if prev in names_hw else (names_hw[0] if names_hw else None)
        if target:
            run(["pactl", "set-default-sink", target])
            affected = dict(st, apps=[a for a in st["apps"] if a["sink"] in {s["idx"] for s in old_sinks}])
            move_all(affected, target)
        if not unload_all_coop():
            return "Could not fully end Co-op; some groups are still loaded"
        if target:                      # the session manager may have picked a leftover sink meanwhile
            run(["pactl", "set-default-sink", target])
            fresh = snapshot()
            move_all(dict(fresh, apps=[a for a in fresh["apps"]
                                       if a["sink"] not in {s["idx"] for s in fresh["sinks"] if s["name"] == target}]), target)
        for key in ("coop_mod", "coop_sink", "coop_prev", "coop_members"):
            rt.pop(key, None)
        return "Co-op ended"
    sel, sync = coop_opts(rt)
    names = coop_members(st, sel)
    if len(names) < 2:
        return "Co-op needs at least two of the chosen devices to be connected"
    previous_default = st.get("default_sink")
    existing = {s["name"] for s in st["sinks"]}
    target = "irminsul_coop" if "irminsul_coop" not in existing else "irminsul_coop_next"
    args = [f"sink_name={target}", "slaves=" + ",".join(names),
            "sink_properties=device.description=Irminsul-Co-op"]
    idx = load_module("module-combine-sink", *args, *(["latency_compensate=true"] if sync else []))
    compensated = sync
    if idx is None and sync:
        idx = load_module("module-combine-sink", *args); compensated = False
    if idx is None:
        return "The server refused Co-op; previous output unchanged"
    ready = DEMO
    for _ in range(20) if not DEMO else ():
        if any(s["name"] == target for s in snapshot()["sinks"]):
            ready = True; break
        time.sleep(0.1)
    if not ready:
        unload_module(idx)
        return "Co-op output did not appear; previous output unchanged"
    gain_ok = True
    if old_sink:
        gain_ok = run(["pactl", "set-sink-volume", target, f"{old_sink['vol']}%"])
        gain_ok = run(["pactl", "set-sink-mute", target, str(int(old_sink["mute"]))]) and gain_ok
    if not gain_ok or not run(["pactl", "set-default-sink", target]):
        unload_module(idx)
        return "Could not activate Co-op; previous output unchanged"
    stuck = move_all(st, target)
    real = [a for a in st["apps"] if not internal_stream(a)]
    if stuck and len(stuck) == len(real):
        for a in real:
            run(["pactl", "move-sink-input", str(a["idx"]), str(a["sink"])])
        if previous_default:
            run(["pactl", "set-default-sink", previous_default])
        unload_module(idx)
        return "Could not route any stream to Co-op; switch rolled back"
    unload_all_coop(keep=idx)
    if previous_default in names_hw:
        rt["coop_prev"] = previous_default
    rt.update(coop_mod=idx, coop_sink=target, coop_members=names)
    suffix = " (latency compensation unavailable)" if sync and not compensated else ""
    if stuck:
        suffix += f" ({len(stuck)} stream(s) stayed on the old output; replay them)"
    return f"Co-op: playing through {len(names)} devices" + suffix


def coop_reload(rt, st):
    sel, _ = coop_opts(rt)
    if len(coop_members(st, sel)) < 2:
        return mode_coop(False, rt, st) + " (fewer than two devices chosen)"
    return mode_coop(True, rt, st)


def coop_control(action, name=None):
    """Headless entry point used by the popup."""
    cfg, rt, st = load_cfg(), load_rt(), snapshot()
    rt.pop("coop_sel", None); rt.pop("coop_sync", None)
    if action == "cleanup":
        msg = mode_coop(False, rt, st) if coop_modules(st) else "No leftover Co-op groups"
        cfg["coop"] = False; save_cfg(cfg); save_rt(rt)
        return dict(ok=True, message=msg)
    if action == "pick":
        if name not in [s["name"] for s in hw_sinks(st)]:
            return dict(ok=False, message="That device is no longer connected")
        selected = list(cfg["coop_devices"] if cfg["coop_devices"] is not None else coop_members(st, None))
        selected.remove(name) if name in selected else selected.append(name)
        cfg["coop_devices"] = selected; rt["coop_sel"] = selected
        save_cfg(cfg)
        msg = coop_reload(rt, st) if coop_module(st) else "Co-op selection saved"
    else:
        msg = mode_coop(not bool(coop_module(st)), rt, st)
    cfg["coop"] = bool(coop_module(snapshot())) if not DEMO else "coop_mod" in rt
    save_cfg(cfg); save_rt(rt)
    return dict(ok=not any(x in msg.lower() for x in ("refused", "could not", "needs at least", "did not appear")), message=msg)


def mode_mono(on, rt, st):
    if on:
        master = st.get("default_sink")
        if not master or master.startswith("irminsul"):
            hw = hw_sinks(st); master = hw[0]["name"] if hw else None
        if not master:
            return "No output to fold into mono"
        idx = load_module("module-remap-sink", "sink_name=irminsul_mono", f"master={master}", "channels=1",
                          "channel_map=mono", "sink_properties=device.description=Irminsul-Mono")
        if idx is None:
            return "The server refused the Mono module"
        rt["mono_mod"], rt["mono_prev"] = idx, master; time.sleep(0.4)
        run(["pactl", "set-default-sink", "irminsul_mono"]); move_all(st, "irminsul_mono")
        return "Mono audio on"
    unload_module(rt.pop("mono_mod", None))
    prev = rt.pop("mono_prev", None)
    if prev:
        run(["pactl", "set-default-sink", prev])
    return "Mono audio off"


def mode_clear_voice(on, rt, st):
    if on:
        src = st.get("default_src")
        if not src or src.startswith("irminsul"):
            hw = [s for s in st.get("srcs", []) if not s["virtual"]]; src = hw[0]["name"] if hw else None
        if not src:
            return "No microphone found"
        idx = load_module("module-echo-cancel", "aec_method=webrtc", f"source_master={src}",
                          "source_name=irminsul_clear_voice", "sink_name=irminsul_aec_ref",
                          "source_properties=device.description=Irminsul-Clear-Voice",
                          "sink_properties=device.description=Irminsul-Echo-Reference")
        if idx is None:
            return "The server refused the Clear Voice module"
        rt["clear_mod"], rt["clear_prev"] = idx, src; time.sleep(0.4)
        run(["pactl", "set-default-source", "irminsul_clear_voice"])
        return "Clear Voice on: noise and echo are being filtered"
    unload_module(rt.pop("clear_mod", None))
    prev = rt.pop("clear_prev", None)
    if prev:
        run(["pactl", "set-default-source", prev])
    return "Clear Voice off"


def mode_loopback(on, rt, st):
    if on:
        idx = load_module("module-loopback", f"source={st.get('default_src') or '@DEFAULT_SOURCE@'}",
                          "latency_msec=40", "source_dont_move=true",
                          "sink_input_properties=media.name=Irminsul-Hear-Yourself")
        if idx is None:
            return "Loopback failed"
        rt["loop_mod"] = idx
        return "You can hear yourself now (mind the feedback)"
    unload_module(rt.pop("loop_mod", None))
    return "Loopback off"


def set_clock(key, value):
    run(["pw-metadata", "-n", "settings", "0", key, str(value)])


# ───────────────────────────── equalizer engine (PipeWire filter-chain) ─────────────────────────────
def eq_conf(gains, preamp, q, target):
    nodes = [f'{{ type = builtin name = preamp label = bq_highshelf control = {{ "Freq" = 0.0 "Q" = 1.0 "Gain" = {preamp:.2f} }} }}']
    for i, (f, g) in enumerate(zip(EQ_FREQS, gains)):
        lab = "bq_lowshelf" if i == 0 else "bq_highshelf" if i == 9 else "bq_peaking"
        nodes.append(f'{{ type = builtin name = eq_band_{i + 1} label = {lab} control = {{ "Freq" = {f:.1f} "Q" = {q:.2f} "Gain" = {g:.2f} }} }}')
    names = ["preamp"] + [f"eq_band_{i + 1}" for i in range(10)]
    links = [f'{{ output = "{a}:Out" input = "{b}:In" }}' for a, b in zip(names, names[1:])]
    tgt = f'target.object = "{target}"' if target else ""
    return f"""# generated by irminsul-settings
context.properties = {{ log.level = 0 }}
context.spa-libs = {{ audio.convert.* = audioconvert/libspa-audioconvert  support.* = support/libspa-support }}
context.modules = [
  {{ name = libpipewire-module-rt args = {{ nice.level = -11 }} flags = [ ifexists nofail ] }}
  {{ name = libpipewire-module-protocol-native }}
  {{ name = libpipewire-module-client-node }}
  {{ name = libpipewire-module-adapter }}
  {{ name = libpipewire-module-filter-chain
    args = {{
      node.description = "Irminsul Equalizer"
      media.name = "Irminsul Equalizer"
      filter.graph = {{
        nodes = [
          {chr(10).join('          ' + n for n in nodes).lstrip()}
        ]
        links = [
          {chr(10).join('          ' + l for l in links).lstrip()}
        ]
      }}
      audio.channels = 2
      audio.position = [ FL FR ]
      capture.props = {{ node.name = "effect_input.irminsul_eq" media.class = Audio/Sink }}
      playback.props = {{ node.name = "effect_output.irminsul_eq" node.passive = true {tgt} }}
    }}
  }}
]
"""


class EQEngine:
    def __init__(self, rt):
        self.rt = rt; self.node = None; self.restart_at = 0

    def running(self):
        if DEMO:
            return self.rt.get("eq_pid") is not None
        pid = self.rt.get("eq_pid")
        if not pid:
            return False
        try:
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                return b"irminsul-eq" in f.read()
        except Exception:
            return False

    def start(self, eq, st):
        target = eq.get("target") or ""
        if not target or target.startswith("effect_input") or target.startswith("irminsul"):
            cur = st.get("default_sink", "")
            target = cur if cur and not cur.startswith("effect_input") else (hw_sinks(st)[0]["name"] if hw_sinks(st) else "")
        self.stop(st, restore=False)
        if DEMO:
            self.rt["eq_pid"] = 1; return "Equalizer awakened"
        try:
            os.makedirs(CFG_DIR, exist_ok=True)
            with open(EQ_CONF, "w") as f:
                f.write(eq_conf(eq["gains"], eq["preamp"], eq["q"], target))
            p = subprocess.Popen(["pipewire", "-c", EQ_CONF], start_new_session=True, env=clean_env(),
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except FileNotFoundError:
            return "pipewire binary not found: the EQ needs PipeWire"
        except Exception as e:
            return f"EQ failed: {e}"
        self.rt["eq_pid"], self.rt["eq_target"] = p.pid, target; self.node = None
        for _ in range(20):
            time.sleep(0.15)
            if "effect_input.irminsul_eq" in sh("pactl", "list", "short", "sinks"):
                break
        run(["pactl", "set-default-sink", "effect_input.irminsul_eq"]); move_all(st, "effect_input.irminsul_eq")
        return "Equalizer awakened"

    def stop(self, st, restore=True):
        pid = self.rt.pop("eq_pid", None); tgt = self.rt.pop("eq_target", None); self.node = None
        if pid and not DEMO:
            try:
                with open(f"/proc/{pid}/cmdline", "rb") as f:
                    if b"irminsul-eq" in f.read():
                        os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
        if restore and tgt:
            time.sleep(0.3); run(["pactl", "set-default-sink", tgt])
        return "Equalizer resting"

    def _node_id(self):
        if self.node:
            return self.node
        try:
            for o in json.loads(sh("pw-dump", timeout=4) or "[]"):
                if o.get("type") == "PipeWire:Interface:Node" and \
                        ((o.get("info") or {}).get("props") or {}).get("node.name") == "effect_input.irminsul_eq":
                    self.node = o["id"]; return self.node
        except Exception:
            pass
        return None

    def update(self, eq, st):
        """Push new gains/Q live; fall back to a quick restart of the chain."""
        if DEMO or not self.running():
            return
        nid = self._node_id()
        params = [f'"preamp:Gain" {eq["preamp"]:.2f}']
        for i, g in enumerate(eq["gains"]):
            params += [f'"eq_band_{i + 1}:Gain" {g:.2f}', f'"eq_band_{i + 1}:Q" {eq["q"]:.2f}']
        if nid is None or not run(["pw-cli", "set-param", str(nid), "Props", "{ params = [ " + " ".join(params) + " ] }"]):
            self.start(eq, st)
        else:
            try:
                with open(EQ_CONF, "w") as f:
                    f.write(eq_conf(eq["gains"], eq["preamp"], eq["q"], self.rt.get("eq_target", "")))
            except Exception:
                pass


def eq_response(gains, preamp, q, n=180, fs=48000.0):
    """True magnitude response (dB) of the biquad cascade, sampled log-spaced 20 Hz..20 kHz."""
    coefs = []
    for i, (f0, g) in enumerate(zip(EQ_FREQS, gains)):
        if abs(g) < 0.01:
            continue
        Aa = 10 ** (g / 40); w0 = 2 * math.pi * f0 / fs; cw, sw = math.cos(w0), math.sin(w0); al = sw / (2 * q)
        if i == 0:
            sa = 2 * math.sqrt(Aa) * al
            b = (Aa * ((Aa + 1) - (Aa - 1) * cw + sa), 2 * Aa * ((Aa - 1) - (Aa + 1) * cw), Aa * ((Aa + 1) - (Aa - 1) * cw - sa))
            a = ((Aa + 1) + (Aa - 1) * cw + sa, -2 * ((Aa - 1) + (Aa + 1) * cw), (Aa + 1) + (Aa - 1) * cw - sa)
        elif i == 9:
            sa = 2 * math.sqrt(Aa) * al
            b = (Aa * ((Aa + 1) + (Aa - 1) * cw + sa), -2 * Aa * ((Aa - 1) + (Aa + 1) * cw), Aa * ((Aa + 1) + (Aa - 1) * cw - sa))
            a = ((Aa + 1) - (Aa - 1) * cw + sa, 2 * ((Aa - 1) - (Aa + 1) * cw), (Aa + 1) - (Aa - 1) * cw - sa)
        else:
            b = (1 + al * Aa, -2 * cw, 1 - al * Aa); a = (1 + al / Aa, -2 * cw, 1 - al / Aa)
        coefs.append((b, a))
    out = []
    for k in range(n):
        f = 20 * (1000 ** (k / (n - 1)))
        z = cmath.exp(-1j * 2 * math.pi * f / fs); z2 = z * z; h = 1
        for b, a in coefs:
            h *= (b[0] + b[1] * z + b[2] * z2) / (a[0] + a[1] * z + a[2] * z2)
        out.append(20 * math.log10(max(1e-9, abs(h))) + preamp)
    return out


# ───────────────────────────── analyzer (real spectrum of what is playing) ─────────────────────────────
class Analyzer(threading.Thread):
    N, RATE, BLOCK = 24, 16000, 512

    def __init__(self):
        super().__init__(daemon=True)
        self.want = False; self.target = "out"; self.stop = False; self.proc = None; self.bands_on = False; self._n = 0
        self.L = [0.0] * self.N; self.R = [0.0] * self.N; self.lv = [0.0, 0.0]; self.peak_db = -90.0
        self.freqs = [50 * (7000 / 50) ** (i / (self.N - 1)) for i in range(self.N)]
        self.coef = [2 * math.cos(2 * math.pi * f / self.RATE) for f in self.freqs]
        self.win = [0.5 - 0.5 * math.cos(2 * math.pi * i / (self.BLOCK - 1)) for i in range(self.BLOCK)]
        if np is not None:
            self.np_win = np.hanning(self.BLOCK)
            bins = np.fft.rfftfreq(self.BLOCK, 1 / self.RATE)
            self.np_idx = [int(np.argmin(np.abs(bins - f))) for f in self.freqs]
        self.t = 0.0

    def _bands(self, xs):
        if np is not None:
            a = np.asarray(xs, dtype=np.float64) * self.np_win
            mag = np.abs(np.fft.rfft(a)) / (self.BLOCK / 4)
            out = []
            for k, i in enumerate(self.np_idx):
                m = float(mag[max(0, i - 1):i + 2].max())
                out.append(m)
        else:
            w = [x * h for x, h in zip(xs, self.win)]
            out = []
            for c in self.coef:
                s1 = s2 = 0.0
                for x in w:
                    s = x + c * s1 - s2; s2 = s1; s1 = s
                out.append(math.sqrt(max(0.0, s1 * s1 + s2 * s2 - c * s1 * s2)) / (self.BLOCK / 4))
        return [max(0.0, min(1.0, (20 * math.log10(m + 1e-9) + 66) / 62)) for m in out]

    def _demo(self):
        self.t += 0.05; t = self.t
        for side, arr in ((0, self.L), (1, self.R)):
            for i in range(self.N):
                base = 0.75 - i / self.N * 0.45
                beat = 0.25 * max(0, math.sin(t * 4.1 + side)) * (1 if i < 6 else 0.3)
                arr[i] = max(0.0, min(1.0, base * (0.6 + 0.4 * math.sin(t * 1.7 + i * 0.55 + side * 0.8)) + beat))
        self.lv = [0.62 + 0.2 * math.sin(t * 3), 0.58 + 0.2 * math.sin(t * 2.6 + 1)]
        self.peak_db = -7.5 + 3 * math.sin(t)

    def run(self):
        while not self.stop:
            if not self.want:
                time.sleep(0.15); continue
            if DEMO:
                self._demo(); time.sleep(0.05); continue
            tgt = self.target
            dev = (sh("pactl", "get-default-sink").strip() + ".monitor") if tgt == "out" else \
                (sh("pactl", "get-default-source").strip() if tgt == "mic" else tgt)
            try:
                self.proc = subprocess.Popen(["parec", "-d", dev, "--format=s16le", f"--rate={self.RATE}", "--channels=2",
                                              "--latency-msec=25", "--client-name=irminsul-astrolabe"],
                                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
                while self.want and not self.stop and self.target == tgt:
                    data = self.proc.stdout.read(self.BLOCK * 4)
                    if not data or len(data) < self.BLOCK * 4:
                        break
                    self._n += 1
                    if np is not None:
                        a = np.frombuffer(data, dtype=np.int16).astype(np.float64) / 32768.0
                        l, r = a[0::2], a[1::2]
                        if self.bands_on:
                            self.L, self.R = self._bands(l), self._bands(r)
                        pk = max(float(np.abs(l).max()), float(np.abs(r).max()), 1e-6)
                        self.peak_db = 20 * math.log10(pk)
                        self.lv = [min(1.0, float(np.sqrt(np.mean(ch * ch))) ** 0.6 * 2.2) for ch in (l, r)]
                    else:
                        arr = array.array("h"); arr.frombytes(data)
                        l = [v / 32768.0 for v in arr[0::2]]; r = [v / 32768.0 for v in arr[1::2]]
                        if self.bands_on and self._n % 2 == 0:      # pure-python Goertzel is heavy: every 2nd block
                            self.L, self.R = self._bands(l), self._bands(r)
                        pk = max(max(map(abs, l)), max(map(abs, r)), 1e-6)
                        self.peak_db = 20 * math.log10(pk)
                        self.lv = [min(1.0, math.sqrt(sum(x * x for x in ch) / len(ch)) ** 0.6 * 2.2) for ch in (l, r)]
            except FileNotFoundError:
                return
            except Exception:
                pass
            self.kill()
            self.L = [0.0] * self.N; self.R = [0.0] * self.N; self.lv = [0.0, 0.0]; self.peak_db = -90.0
            time.sleep(0.2)

    def kill(self):
        try:
            self.proc.terminate()
        except Exception:
            pass

    def close(self):
        self.stop = True; self.kill()


# ───────────────────────────── test sounds ─────────────────────────────
def _play(frames, rate, channels, device=None):
    pcm = array.array("h", [int(max(-1, min(1, v)) * 32000) for v in frames]).tobytes()
    cmd = ["paplay", "--raw", f"--rate={rate}", f"--channels={channels}", "--format=s16le",
           "--client-name=irminsul-trial", "--stream-name=Irminsul trial"]
    if device:
        cmd.append(f"--device={device}")
    if DEMO:
        return
    try:
        subprocess.run(cmd, input=pcm, timeout=12)
    except Exception:
        pass


def play_channel(side, device=None):
    """Wind-chime arpeggio on the left, right or both speakers."""
    rate, n = 44100, int(44100 * 1.4); out = [0.0] * (n * 2)
    for k, f in enumerate((659.25, 783.99, 987.77, 1318.51)):
        off = int(rate * 0.1 * k)
        for i in range(n - off):
            t = i / rate; v = min(1.0, t * 90) * math.exp(-t * 3.8) * (math.sin(2 * math.pi * f * t) + 0.25 * math.sin(4 * math.pi * f * t)) * 0.2
            j = (off + i) * 2
            if side in ("left", "both"):
                out[j] += v
            if side in ("right", "both"):
                out[j + 1] += v
    _play(out, rate, 2, device)


def play_sweep(device=None):
    rate, dur = 44100, 6.0; n = int(rate * dur); f0, f1 = 20.0, 20000.0; k = math.log(f1 / f0)
    out = []
    for i in range(n):
        t = i / rate; ph = 2 * math.pi * f0 * dur / k * (math.exp(t / dur * k) - 1)
        env = min(1.0, t * 20, (dur - t) * 20)
        out.append(math.sin(ph) * 0.22 * env)
    _play(out, rate, 1, device)


def play_pink(device=None):
    rate, n = 44100, 44100 * 3; b = [0.0] * 7; out = []; rnd = random.Random(3)
    for i in range(n):
        w = rnd.uniform(-1, 1)
        b[0] = 0.99886 * b[0] + w * 0.0555179; b[1] = 0.99332 * b[1] + w * 0.0750759
        b[2] = 0.96900 * b[2] + w * 0.1538520; b[3] = 0.86650 * b[3] + w * 0.3104856
        b[4] = 0.55000 * b[4] + w * 0.5329522; b[5] = -0.7616 * b[5] - w * 0.0168980
        v = sum(b[:6]) + b[6] + w * 0.5362; b[6] = w * 0.115926
        env = min(1.0, i / 2000, (n - i) / 2000)
        out.append(v * 0.05 * env)
    _play(out, rate, 1, device)


def play_tone(freq, device=None):
    rate, n = 44100, int(44100 * 2.0)
    _play([math.sin(2 * math.pi * freq * i / rate) * 0.25 * min(1.0, i / 800, (n - i) / 800) for i in range(n)], rate, 1, device)


# ───────────────────────────── Night Watch worker (detached process) ─────────────────────────────
def night_curve(curve, f):
    f = max(0.0, min(1.0, f))
    return 1 - f if curve == 0 else (1 - f) ** 2 if curve == 1 else (1.0 if f < 0.65 else 1 - (f - 0.65) / 0.35)


def night_watch(minutes, curve, action):
    st = snapshot(); sink = st.get("default_sink") or "@DEFAULT_SINK@"
    v0 = next((s["vol"] for s in st["sinks"] if s["name"] == sink), 50)
    dur = max(1.0, minutes * 60); start = time.time()
    rt = load_rt(); rt["night"] = dict(pid=os.getpid(), start=start, dur=dur, v0=v0, action=action, curve=curve); save_rt(rt)
    stop = {"x": False}
    signal.signal(signal.SIGTERM, lambda *_: stop.update(x=True))
    while not stop["x"]:
        f = (time.time() - start) / dur
        run(["pactl", "set-sink-volume", sink, f"{int(v0 * night_curve(curve, f))}%"])
        if f >= 1:
            break
        time.sleep(3)
    if not stop["x"]:
        if action in (1, 2):
            run(["playerctl", "-a", "pause"])
        if action in (0, 2):
            run(["pactl", "set-sink-mute", sink, "1"])
    run(["pactl", "set-sink-volume", sink, f"{v0}%"])
    rt = load_rt(); rt.pop("night", None); save_rt(rt)


def restore_all():
    """Re-apply everything that lives in the server and is lost on restart / reboot."""
    cfg, rt, st = load_cfg(), load_rt(), snapshot()
    rt.pop("coop_sel", None); rt.pop("coop_sync", None)
    if cfg["force_rate"]:
        set_clock("clock.force-rate", cfg["force_rate"])
    if cfg["force_quantum"]:
        set_clock("clock.force-quantum", cfg["force_quantum"])
    if cfg["allowed_rates"]:
        set_clock("clock.allowed-rates", cfg["allowed_rates"])
    for key, fn, mk in (("mono", mode_mono, "mono_mod"), ("coop", mode_coop, "coop_mod"),
                        ("clear_voice", mode_clear_voice, "clear_mod")):
        if cfg[key] and not mod_alive(st, rt.get(mk)):
            rt.pop(mk, None); print(fn(True, rt, st)); st = snapshot()
    if cfg["eq"]["enabled"]:
        eng = EQEngine(rt)
        if not eng.running():
            print(eng.start(cfg["eq"], st))
    save_rt(rt)


