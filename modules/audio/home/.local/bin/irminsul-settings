        lv = max(self.lv); n = 20; seg = (x1 - x0 - 70) / n
        for i in range(n):
            on = lv * n > i; c = EL[2][1] if i < 13 else EL[6][1] if i < 17 else EL[0][1]
            rrect(cr, x0 + i * seg, cy - 8, seg - 4, 16, 3); A(cr, c if on else NAVY3, 0.95 if on else 0.6); cr.fill()
