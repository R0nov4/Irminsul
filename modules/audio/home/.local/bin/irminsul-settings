#!/usr/bin/env python3
"""
irminsul-settings  —  The Resonance Archive
Genshin-styled advanced sound settings for irminsul-volume (GTK3 + Cairo, talks to PipeWire / PulseAudio).

Pages
  Outputs      port, volume up to 150 %, L/R balance, suspend, set default, Co-op (any devices you pick), Mono
  Inputs       port, boost, balance, Clear Voice (WebRTC noise suppression), Hear Yourself (loopback), live level
  Party        per-app output routing, boost, balance, banish stream, recording-stream routing
  Profiles     card profiles (A2DP / HFP / 5.1 / HDMI ...) and Bluetooth codecs (LDAC, aptX, AAC ...)
  Equalizer    real 10-band parametric EQ (PipeWire filter-chain) with presets, preamp, band width
  Astrolabe    live stereo radial spectrum, peak meter, L/R speaker test, sweep, pink noise, tone generator
  Engine       force sample rate / quantum (latency), allowed rates, loaded modules, restart audio stack
  Mixer        how the popup behaves (position, step, ceiling, presets, sections, motion)
  Night Watch  sleep timer that fades the music out and pauses players

Everything is vector-drawn with Cairo. No game assets.
Deps: python-gobject python-cairo gtk3 + pactl/parec/paplay (libpulse), pw-metadata/pw-cli (pipewire)
      optional: playerctl (Night Watch pause), python-numpy (faster spectrum)

Usage:
  irminsul-settings                open (or focus) the archive
  irminsul-settings --page eq      open on a page: outputs inputs streams profiles eq astro engine mixer night
  irminsul-settings --restore      re-apply saved EQ / Mono / Co-op / Clear Voice / clock  (use as exec-once)
  irminsul-settings --demo         fake devices, to try the UI without touching your audio
"""
import os, sys, re, json, math, time, random, array, signal, cmath, subprocess, threading
from concurrent.futures import ThreadPoolExecutor

