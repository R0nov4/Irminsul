    def page_streams(self, y):
        st = self.st; apps, sinks = st["apps"], st["sinks"]; lim = self.cfg["boost_limit"]
        y = self.section(y, "Playback", f"{len(apps)} playing" if apps else "")
        if not apps:
            y = self.empty(y, "The party is quiet. Play something and it will appear here.")
        for a in apps:
            idx = a["idx"]

            def right(x1, cy, a=a):
                self.gbutton(f"ban:{a['idx']}", x1 - 140, cy - 20, 140, 40, "Banish", lambda: self.ask(
                    "Banish this stream?", f"{a['name']} will lose its connection to the sound server. Most apps simply "
                    "reconnect the next time they play.", "Banish",
                    lambda: self.do(["pactl", "kill-sink-input", str(a["idx"])], f"{a['name']} was banished")), glyph="x", dark=True)
            sub = (a["media"] or "Playing") + ("  ·  paused" if a["corked"] else "")
            y = self.card(y, a["name"], sub, el=0, icons=a["icons"], current=not a["corked"], right=right)
            names = [s["name"] for s in sinks]; i = next((j for j, s in enumerate(sinks) if s["idx"] == a["sink"]), 0)

            def mv(j, a=a):
                s = sinks[j % len(sinks)]
                self.do(["pactl", "move-sink-input", str(a["idx"]), s["name"]], f"{a['name']} → {s['desc']}")
            x0, x1, cy = self.row(y, "Output", "Where this app plays", el=0,
                                  info="Send just this app to another device. The rest of the party stays where it is. "
                                       "WirePlumber remembers the choice next time the app plays.")
            if sinks:
                self.selector(f"mv:{idx}", x0, x1, cy, sinks[i]["desc"], lambda i=i, mv=mv: mv(i - 1), lambda i=i, mv=mv: mv(i + 1))
            y += 62
            kv, kb, km, kl = f"v:si:{idx}", f"b:si:{idx}", f"m:si:{idx}", f"lvl:si:{idx}"
            vol, bal, mute = self.hv(kv, a["vol"]), self.hv(kb, a["bal"]), self.hv(km, a["mute"])

            def setv(v, a=a, kv=kv, kb=kb, kl=kl):
                self.sethold(kv, v); self.level("sink-input", a["idx"], a["ch"], v, self.hv(kb, a["bal"]), kl)

            def setb(b, a=a, kv=kv, kb=kb, kl=kl):
                self.sethold(kb, b); self.level("sink-input", a["idx"], a["ch"], self.hv(kv, a["vol"]), b, kl)
            x0, x1, cy = self.row(y, "Volume", el=0, info="This app's own volume, independent of the device. "
                                  "Boost a whispering video call past 100 %. Right-click for 100 %.")
            self.slider(kv, x0, x1, cy, vol, 0, lim, setv, mark=100, el=0, muted=mute, alt=lambda setv=setv: setv(100))
            y += 62
            if len(a["ch"]) >= 2:
                x0, x1, cy = self.row(y, "Balance", el=0, info="Pan this app left or right. Right-click to centre.")
                self.slider(kb, x0, x1, cy, bal, -100, 100, setb, fmt=fmt_bal, center=0, el=0, alt=lambda setb=setb: setb(0))
                y += 62
            x0, x1, cy = self.row(y, "Mute", el=0, info="Silence only this app.")
            self.toggle(km, x1, cy, mute, lambda km=km, mute=mute, idx=idx: (
                self.sethold(km, not mute), self.do(["pactl", "set-sink-input-mute", str(idx), "toggle"])))
            y += 78
        recs, srcs = st["recs"], st["srcs"]
        y = self.section(y, "Recording", f"{len(recs)} listening" if recs else "")
        if not recs:
            return self.empty(y, "Nothing is using a microphone.")
        for r in recs:
            i = next((j for j, s in enumerate(srcs) if s["idx"] == r["src"]), 0)

            def mv(j, r=r):
                s = srcs[j % len(srcs)]
                self.do(["pactl", "move-source-output", str(r["idx"]), s["name"]], f"{r['name']} now hears {s['desc']}")
            x0, x1, cy = self.row(y, r["name"], r["media"] or "Recording", el=2,
                                  info="Choose which microphone this app listens to, without changing your default.")
            if srcs:
                self.selector(f"rec:{r['idx']}", x0, x1, cy, srcs[i]["desc"], lambda i=i, mv=mv: mv(i - 1), lambda i=i, mv=mv: mv(i + 1))
            y += 62
        return y

    def page_profiles(self, y):
        cards = self.st["cards"]
        y = self.section(y, "Sound Cards", f"{len(cards)} found")
        if not cards:
            return self.empty(y, "No sound cards reported by the server.")
        for c in cards:
            y = self.card(y, c["desc"], c["name"], kind="bt" if c["bluez"] else "card", el=3, current=c["active"] != "off")
            profs = [p for p in c["profiles"] if p[2] or p[0] == c["active"]] or c["profiles"]
            names = [p[0] for p in profs]; i = names.index(c["active"]) if c["active"] in names else 0

            def setp(j, c=c, profs=profs):
                p = profs[j % len(profs)]
                self.do(["pactl", "set-card-profile", c["name"], p[0]], f"{c['desc']}: {p[1]}")
            x0, x1, cy = self.row(y, "Profile", f"{len(profs)} available", el=3,
                                  info="The card's mode. Stereo or 5.1 surround, analog or HDMI, duplex with the mic "
                                       "or output only. For Bluetooth: A2DP is high-fidelity, HSP/HFP enables the mic "
                                       "at phone quality. 'Off' frees the card.", cw=min(400, self.RW * 0.62))
            if profs:
                self.selector(f"prof:{c['name']}", x0, x1, cy, profs[i][1], lambda i=i, s=setp: s(i - 1), lambda i=i, s=setp: s(i + 1))
            y += 62
            if c["bluez"]:
                info = self.codecs.get(c["name"])
                x0, x1, cy = self.row(y, "Codec", "How audio travels over the air", el=3,
                                      info="LDAC and aptX HD carry the most detail, AAC suits Apple gear, SBC works "
                                           "everywhere, LC3 is the new low-energy codec. Only codecs both sides support "
                                           "appear. Requires PipeWire.")
                if info is None:
                    self.selector(f"codec:{c['name']}", x0, x1, cy, "Reading codecs…", lambda: None, lambda: None, dim=True)
                elif not info[0]:
                    self.selector(f"codec:{c['name']}", x0, x1, cy, "Not available in this profile", lambda: None, lambda: None, dim=True)
                else:
                    lst, cur = info; nm = [n for n, _ in lst]; j = nm.index(cur) if cur in nm else 0

                    def setc(k, c=c, lst=lst):
                        n, dsc = lst[k % len(lst)]

                        def job():
                            ok = run(["pactl", "send-message", f"/card/{c['name']}/bluez", "switch-codec", json.dumps(n)])
                            self.host.idle(lambda: (self.codecs.__setitem__(c["name"], (lst, n)) if ok else None,
                                                    self.toast(f"Codec: {dsc}" if ok else "The headset refused that codec")))
                        POOL.submit(job)
                    self.selector(f"codec:{c['name']}", x0, x1, cy, lst[j][1], lambda j=j, s=setc: s(j - 1), lambda j=j, s=setc: s(j + 1))
                y += 62
            y += 16
        return y

    def page_eq(self, y):
        eq = self.cfg["eq"]; cr = self.cr; running = self.eq.running()
        y = self.eq_canvas(y, eq, running)
        x0, x1, cy = self.row(y, "Equalizer", "Runs inside PipeWire as a virtual device", el=4,
                              info="Starts a PipeWire filter-chain called 'Irminsul Equalizer', makes it the default "
                                   "output and routes it to your device. Switch off to bypass it completely.")
        self.toggle("eq", x1, cy, running, self.eq_toggle, "eq" in self.busy)
        y += 62
        names = [p[0] for p in EQ_PRESETS]; i = names.index(eq["preset"]) if eq["preset"] in names else -1

        def setp(j):
            n, g = EQ_PRESETS[j % len(EQ_PRESETS)]; eq["preset"], eq["gains"] = n, list(g); self.eq_changed()
        x0, x1, cy = self.row(y, "Preset", "Seven elements, seven characters", el=4,
                              info="Geo for bass weight, Hydro for warmth, Anemo for clear voices, Cryo for sparkle, "
                                   "Electro for the V-shaped 'fun' curve, Pyro for loudness at low volume, Dendro for "
                                   "podcasts. Moving any star turns it into Custom.")
        self.selector("eqp", x0, x1, cy, eq["preset"] if i >= 0 else "Custom", lambda: setp(i - 1 if i >= 0 else 0), lambda: setp(i + 1))
        y += 62
        qi = min(range(3), key=lambda k: abs(Q_OPTS[k][1] - eq["q"]))

        def setq(k):
            eq["q"] = Q_OPTS[k % 3][1]; self.eq_changed()
        x0, x1, cy = self.row(y, "Band Width", f"Q {eq['q']:.2f}", el=4,
                              info="How wide each star reaches. Narrow is surgical, for taming a single harsh "
                                   "note. Wide is musical, for broad tone shaping.")
        self.selector("eqq", x0, x1, cy, Q_OPTS[qi][0], lambda: setq(qi - 1), lambda: setq(qi + 1))
        y += 62

        def setpre(v):
            eq["preamp"] = v; self.eq_changed()
        x0, x1, cy = self.row(y, "Preamp", "Headroom before the bands", el=4,
                              info="Lowers everything before the bands so boosts cannot clip. A good rule: preamp "
                                   "equal to minus your largest boost. Right-click for 0 dB.")
        self.slider("eqpre", x0, x1, cy, eq["preamp"], -15, 6, setpre, fmt=fmt_db, step=0.5, center=0, el=4, alt=lambda: setpre(0))
        y += 62
        hw = hw_sinks(self.st); tn = [s["name"] for s in hw]
        tgt = eq.get("target") or self.rt.get("eq_target") or ""
        ti = tn.index(tgt) if tgt in tn else -1

        def sett(j):
            if hw:
                eq["target"] = hw[j % len(hw)]["name"]; self.save(); self.eq_restart()
        x0, x1, cy = self.row(y, "Output Through", "The device the EQ feeds", el=4,
                              info="The real device that receives the equalized sound. Leave it on your usual "
                                   "output; changing it while the EQ runs re-routes it instantly.")
        self.selector("eqt", x0, x1, cy, hw[ti]["desc"] if ti >= 0 else "Current default device",
                      lambda: sett(ti - 1 if ti >= 0 else 0), lambda: sett(ti + 1))
        y += 62
        x0, x1, cy = self.row(y, "Tools", el=4, info="Auto preamp sets headroom from the real curve peak. "
                              "Reset flattens every band. Right-click any star to flatten just that one.")
        bw = (x1 - x0 - 12) / 2

        def autop():
            pk = max(eq_response(eq["gains"], 0, eq["q"], 120)); eq["preamp"] = -math.ceil(max(0, pk) * 2) / 2; self.eq_changed()
            self.toast(f"Preamp set to {fmt_db(eq['preamp'])}")
        self.gbutton("eqauto", x0, cy - 20, bw, 40, "Auto preamp", autop, dark=True)
        self.gbutton("eqreset", x0 + bw + 12, cy - 20, bw, 40, "Reset bands", lambda: setp(0), glyph="x", dark=True)
        return y + 62

    def eq_canvas(self, y, eq, running):
        cr, x, w = self.cr, self.CX0, self.RW; h = 330
        rrect(cr, x, y, w, h, 14); A(cr, DEEP, 0.55); cr.fill_preserve(); A(cr, GOLD, 0.3); cr.set_line_width(1); cr.stroke()
        px0, px1, py0, py1 = x + 64, x + w - 34, y + 48, y + h - 58
        zero = (py0 + py1) / 2; half = (py1 - py0) / 2
        dy = lambda g: zero - max(-13, min(13, g)) / 12 * half
        fx = lambda f: px0 + math.log(f / 20) / math.log(1000) * (px1 - px0)
        for g in (12, 6, 0, -6, -12):
            cr.set_line_width(1); A(cr, GOLD, 0.35 if g == 0 else 0.1); cr.move_to(px0 - 10, dy(g)); cr.line_to(px1 + 10, dy(g)); cr.stroke()
            text(cr, ("+" if g > 0 else "−" if g < 0 else "") + str(abs(g)), x + 22, dy(g), 12, IVORY, 0.5)
        for f in (100, 1000, 10000):
            A(cr, GOLD, 0.08); cr.move_to(fx(f), py0 - 6); cr.line_to(fx(f), py1 + 6); cr.stroke()
        text(cr, f"Preamp {fmt_db(eq['preamp'])}   ·   Q {eq['q']:.2f}   ·   {eq['preset']}", x + 22, y + 22, 13, GOLD, 0.85)
        sc = EL[4][1] if running else MUTE_C
        cr.new_path(); cr.arc(x + w - 100, y + 22, 4.5, 0, 2 * math.pi); A(cr, sc, 0.6 + 0.4 * math.sin(self.t * 3) if running else 0.8); cr.fill()
        text(cr, "Live" if running else "Resting", x + w - 88, y + 22, 13, sc, bold=True)
        sig = (tuple(eq["gains"]), eq["preamp"], eq["q"])
        if sig != self.eq_sig:
            self.eq_sig, self.eq_resp = sig, eq_response(eq["gains"], eq["preamp"], eq["q"])
        resp = self.eq_resp; n = len(resp)
        pts = [(px0 + (px1 - px0) * k / (n - 1), dy(v)) for k, v in enumerate(resp)]
        cr.move_to(*pts[0])
        for p in pts[1:]:
            cr.line_to(*p)
        cr.line_to(px1, zero); cr.line_to(px0, zero); cr.close_path()
        g = cairo.LinearGradient(px0, 0, px1, 0)
        for k in range(7):
            c = el_grad(k / 6); g.add_color_stop_rgba(k / 6, c[0], c[1], c[2], 0.26 if running else 0.08)
        cr.set_source(g); cr.fill()
        for lw, col, al in ((8, GOLD, 0.12), (2.4, GOLD_HI if running else MUTE_C, 1.0)):
            cr.move_to(*pts[0])
            for p in pts[1:]:
                cr.line_to(*p)
            cr.set_line_width(lw); A(cr, col, al); cr.stroke()
        labels = ["32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k"]
        for i, f in enumerate(EQ_FREQS):
            kx, ky, col, id = fx(f), dy(eq["gains"][i]), el_grad(i / 9), f"band{i}"
            hov = self.over(kx - 20, py0 - 14, 40, py1 - py0 + 28) or self.is_active(id)
            cr.set_line_width(1); A(cr, col, 0.3 if hov else 0.1); cr.move_to(kx, py0 - 8); cr.line_to(kx, py1 + 8); cr.stroke()
            gl = cairo.RadialGradient(kx, ky, 0, kx, ky, 22)
            gl.add_color_stop_rgba(0, col[0], col[1], col[2], 0.55 if hov else 0.3); gl.add_color_stop_rgba(1, col[0], col[1], col[2], 0)
            cr.set_source(gl); cr.new_path(); cr.arc(kx, ky, 22, 0, 2 * math.pi); cr.fill()
            star(cr, kx, ky, 12 if hov else 9.5, 0.3, self.t * 0.6 if hov else 0); A(cr, col); cr.fill_preserve()
            A(cr, GOLD_HI); cr.set_line_width(1.2); cr.stroke()
            diamond(cr, kx, ky, 2.2); A(cr, INK); cr.fill()
            text(cr, labels[i], kx, py1 + 26, 12.5, IVORY if hov else IVORY, 1.0 if hov else 0.6, bold=hov, anchor="c")
            if hov:
                lab = fmt_db(eq["gains"][i]); tw = measure(cr, lab, 13, True) + 18; ly = ky - 30 if ky > py0 + 30 else ky + 30
                rrect(cr, kx - tw / 2, ly - 13, tw, 26, 13); A(cr, DEEP, 0.92); cr.fill_preserve(); A(cr, col, 0.8); cr.stroke()
                text(cr, lab, kx, ly, 13, IVORY, bold=True, anchor="c")

            def setg(mx, my, i=i):
                self.eq_set(i, max(-12.0, min(12.0, round((zero - my) / half * 12 * 2) / 2)))
            self.hit(id, kx - 20, py0 - 14, 40, py1 - py0 + 28, press=setg, drag=setg, alt=lambda i=i: self.eq_set(i, 0.0),
                     scroll=lambda d, i=i: self.eq_set(i, max(-12.0, min(12.0, eq["gains"][i] + d * 0.5))))
        return y + h + 12

    def page_astro(self, y):
        a = self.cfg["astro"]
        y = self.astro_canvas(y)
        src = ["out", "mic"]; si = src.index(a["source"]) if a["source"] in src else 0

        def sets(j):
            a["source"] = src[j % 2]; self.save()
        x0, x1, cy = self.row(y, "Listening To", el=5, info="Watch what you hear, or what your microphone hears.")
        self.selector("asrc", x0, x1, cy, ["System output", "Microphone"][si], lambda: sets(si - 1), lambda: sets(si + 1))
        y += 62
        mi = a["smooth"]

        def setm(j):
            a["smooth"] = j % 3; self.save()
        x0, x1, cy = self.row(y, "Motion", el=5, info="How quickly the stars fall back. Swift for drums, Dreamy for ambient.")
        self.selector("asm", x0, x1, cy, SMOOTH[mi][0], lambda: setm(mi - 1), lambda: setm(mi + 1))
        y += 62
        y = self.section(y, "Speaker Trial")
        sinks = self.st["sinks"]; opts = [None] + [s["name"] for s in sinks]; self.test_dev %= max(1, len(opts))
        dev = opts[self.test_dev]
        x0, x1, cy = self.row(y, "Trial Device", el=5, info="Which device plays the trial sounds.")
        lab = "Default output" if dev is None else sinks[self.test_dev - 1]["desc"]
        self.selector("tdev", x0, x1, cy, lab, lambda: setattr(self, "test_dev", (self.test_dev - 1) % len(opts)),
                      lambda: setattr(self, "test_dev", (self.test_dev + 1) % len(opts)))
        y += 62
        x0, x1, cy = self.row(y, "Left · Both · Right", "Wind chimes per channel", el=5,
                              info="Plays a short chime on one side at a time. If 'Left' comes from the right, "
                                   "your speakers or cable are swapped.", cw=min(400, self.RW * 0.6))
        bw = (x1 - x0 - 16) / 3
        for k, (lab, side) in enumerate((("Left", "left"), ("Both", "both"), ("Right", "right"))):
            self.gbutton(f"ch{side}", x0 + k * (bw + 8), cy - 20, bw, 40, lab,
                         lambda s=side: POOL.submit(play_channel, s, dev), glyph="play", dark=True)
        y += 62
        x0, x1, cy = self.row(y, "Frequency Sweep", "20 Hz to 20 kHz in six seconds", el=5,
                              info="A smooth glide across the whole audible range. Listen for rattles, sudden dips "
                                   "or the moment your hearing (or your speaker) gives up.")
        self.gbutton("sweep", x1 - 190, cy - 20, 190, 40, "Play sweep", lambda: POOL.submit(play_sweep, dev), glyph="wave", dark=True)
        y += 62
        x0, x1, cy = self.row(y, "Pink Noise", "Three seconds, equal energy per octave", el=5,
                              info="The calibration sound engineers use. Every octave carries the same energy, so "
                                   "a balanced system sounds even, like steady rain.")
        self.gbutton("pink", x1 - 190, cy - 20, 190, 40, "Play noise", lambda: POOL.submit(play_pink, dev), glyph="wave", dark=True)
        y += 62
        x0, x1, cy = self.row(y, "Tone Generator", "Pure sine, two seconds", el=5,
                              info="A single clean frequency. Low tones test the subwoofer, high tones test "
                                   "tweeters and your ears.", cw=min(400, self.RW * 0.6))
        ti = self.tone_i; f = TONES[ti]
        self.selector("tone", x0, x0 + (x1 - x0) * 0.56, cy, f"{f / 1000:g} kHz" if f >= 1000 else f"{f} Hz",
                      lambda: setattr(self, "tone_i", (ti - 1) % len(TONES)), lambda: setattr(self, "tone_i", (ti + 1) % len(TONES)))
        self.gbutton("tplay", x0 + (x1 - x0) * 0.56 + 10, cy - 20, (x1 - x0) * 0.44 - 10, 40, "Play",
                     lambda: POOL.submit(play_tone, f, dev), glyph="play", dark=True)
        return y + 62

    def astro_canvas(self, y):
        cr, x, w = self.cr, self.CX0, self.RW; h = 350; N = Analyzer.N
        rrect(cr, x, y, w, h, 14); A(cr, DEEP, 0.6); cr.fill_preserve(); A(cr, GOLD, 0.3); cr.set_line_width(1); cr.stroke()
        cx, cy, R0, L = x + w / 2, y + h / 2, 84, 70
        rot = self.t * 0.06
        cr.set_line_width(1); A(cr, GOLD, 0.12); cr.new_path(); cr.arc(cx, cy, R0 + L + 12, 0, 2 * math.pi); cr.stroke()
        for i in range(8):
            a = rot + i * math.pi / 4
            diamond(cr, cx + (R0 + L + 12) * math.cos(a), cy + (R0 + L + 12) * math.sin(a), 3); A(cr, GOLD, 0.4); cr.fill()
        star(cr, cx, cy, R0 + L, 0.06, -rot * 0.5); A(cr, GOLD, 0.035); cr.fill()
        for s in (0, 1):
            sign = 1 if s == 1 else -1
            for i in range(N):
                ang = -math.pi / 2 + sign * (i + 0.5) / N * math.pi
                v, p = self.sp[s][i], self.pk[s][i]; col = el_grad(i / (N - 1))
                ca, sa = math.cos(ang), math.sin(ang); r1 = R0 + 6 + v * L
                cr.set_line_cap(cairo.LINE_CAP_ROUND)
                cr.set_line_width(11); A(cr, col, 0.10 + 0.15 * v); cr.move_to(cx + (R0 + 4) * ca, cy + (R0 + 4) * sa)
                cr.line_to(cx + r1 * ca, cy + r1 * sa); cr.stroke()
                cr.set_line_width(5.2); A(cr, col, 0.95); cr.move_to(cx + (R0 + 4) * ca, cy + (R0 + 4) * sa)
                cr.line_to(cx + r1 * ca, cy + r1 * sa); cr.stroke()
                rp = R0 + 14 + p * L
                diamond(cr, cx + rp * ca, cy + rp * sa, 2.6); A(cr, GOLD_HI, 0.75); cr.fill()
        g = cairo.RadialGradient(cx, cy - 20, 6, cx, cy, R0 - 6)
        g.add_color_stop_rgba(0, 0.23, 0.26, 0.35, 0.98); g.add_color_stop_rgba(1, 0.12, 0.13, 0.19, 0.98)
        cr.set_source(g); cr.new_path(); cr.arc(cx, cy, R0 - 6, 0, 2 * math.pi); cr.fill()
        cr.set_line_width(1); A(cr, GOLD, 0.6); cr.new_path(); cr.arc(cx, cy, R0 - 6, 0, 2 * math.pi); cr.stroke()
        for i in range(60):
            a = i * math.pi / 30 - rot * 2; ln = 6 if i % 5 == 0 else 3
            cr.move_to(cx + (R0 - 10) * math.cos(a), cy + (R0 - 10) * math.sin(a))
            cr.line_to(cx + (R0 - 10 - ln) * math.cos(a), cy + (R0 - 10 - ln) * math.sin(a))
            A(cr, GOLD, 0.45 if i % 5 == 0 else 0.2); cr.stroke()
        db = self.an.peak_db
        text(cr, f"{max(-60.0, db):.1f}" if db > -89 else "—", cx, cy - 8, 30, IVORY, bold=True, anchor="c")
        text(cr, "dBFS peak", cx, cy + 20, 12.5, GOLD, anchor="c")
        if db > -0.3:
            text(cr, "Overload", cx, cy + 40, 12.5, DANGER, bold=True, anchor="c")
        text(cr, "50 Hz", cx, cy - R0 - L - 24 if False else y + 18, 12, IVORY, 0.45, anchor="c")
        text(cr, "7 kHz", cx, y + h - 18, 12, IVORY, 0.45, anchor="c")
        for s, mx in ((0, x + 46), (1, x + w - 46)):
            text(cr, "L" if s == 0 else "R", mx, y + 30, 16, GOLD_HI, bold=True, anchor="c")
            n = 18; top, bot = y + 52, y + h - 30; seg = (bot - top) / n
            for k in range(n):
                on = self.lv[s] * n > k; c = EL[2][1] if k < 11 else EL[6][1] if k < 15 else EL[0][1]
                yy = bot - (k + 1) * seg
                rrect(cr, mx - 9, yy + 2, 18, seg - 4, 3); A(cr, c if on else NAVY3, 0.95 if on else 0.55); cr.fill()
        lab = "Microphone" if self.an.target == "mic" else "System output"
        text(cr, lab, x + 80, y + 30, 13, GOLD, 0.85)
        return y + h + 12

    def page_engine(self, y):
        st, cfg = self.st, self.cfg; ck = st.get("clock", {}); info = st.get("info", {})
        y = self.section(y, "Ley Line Clock")
        rate = int(float(ck.get("clock.force-rate") or 0) or float(ck.get("clock.rate") or 48000))
        q = int(float(ck.get("clock.force-quantum") or 0) or float(ck.get("clock.quantum") or 1024))
        y = self.info_row(y, "Server", info.get("server_name", "unknown"), info=f"Protocol version {info.get('server_version', '?')}.", el=6)
        y = self.info_row(y, "Native Format", info.get("default_sample_specification", ""), el=6,
                          info="The format the server mixes in before converting for each device.")
        y = self.info_row(y, "Clock Now", f"{rate / 1000:g} kHz  ·  quantum {q}  ·  {q / rate * 1000:.1f} ms", el=6,
                          info="The live graph clock. Each cycle the server processes 'quantum' samples; that is "
                               "the floor for your output latency.")
        ri = RATES.index(cfg["force_rate"]) if cfg["force_rate"] in RATES else 0

        def setr(j):
            v = RATES[j % len(RATES)]; cfg["force_rate"] = v; self.save()
            POOL.submit(set_clock, "clock.force-rate", v); self.toast("Sample rate: " + (f"{v / 1000:g} kHz" if v else "automatic"))
        x0, x1, cy = self.row(y, "Force Sample Rate", "Lock the whole graph", el=6,
                              info="Locks every device to one rate so nothing is resampled. Pick 44.1 kHz for "
                                   "CD-quality music libraries, 48 kHz for games and video. Automatic lets PipeWire choose.")
        self.selector("frate", x0, x1, cy, f"{RATES[ri] / 1000:g} kHz" if RATES[ri] else "Automatic", lambda: setr(ri - 1), lambda: setr(ri + 1))
        y += 62
        qi = QUANTA.index(cfg["force_quantum"]) if cfg["force_quantum"] in QUANTA else 0

        def setq(j):
            v = QUANTA[j % len(QUANTA)]; cfg["force_quantum"] = v; self.save()
            POOL.submit(set_clock, "clock.force-quantum", v); self.toast("Quantum: " + (str(v) if v else "automatic"))
        x0, x1, cy = self.row(y, "Force Quantum", "Buffer size per cycle", el=6,
                              info="Smaller numbers mean lower latency (rhythm games, live monitoring, music "
                                   "production) but more CPU wake-ups and a risk of crackles. 1024 is the relaxed default.")
        lab = f"{QUANTA[qi]}  ·  {QUANTA[qi] / rate * 1000:.1f} ms" if QUANTA[qi] else "Automatic"
        self.selector("fq", x0, x1, cy, lab, lambda: setq(qi - 1), lambda: setq(qi + 1))
        y += 62
        ai = next((k for k, (v, _) in enumerate(ALLOWED) if v == cfg["allowed_rates"]), 0)

        def seta(j):
            v = ALLOWED[j % len(ALLOWED)][0]; cfg["allowed_rates"] = v; self.save()
            if v:
                POOL.submit(set_clock, "clock.allowed-rates", v)
            else:
                POOL.submit(run, ["pw-metadata", "-n", "settings", "-d", "0", "clock.allowed-rates"])
        x0, x1, cy = self.row(y, "Allowed Rates", "Follow the music's own rate", el=6,
                              info="When a song arrives at 44.1 or 96 kHz, PipeWire may switch the hardware to "
                                   "match it (bit-perfect), as long as the rate is in this list and nothing else is playing.")
        self.selector("arate", x0, x1, cy, ALLOWED[ai][1], lambda: seta(ai - 1), lambda: seta(ai + 1))
        y += 62
        y = self.section(y, "Maintenance")
        x0, x1, cy = self.row(y, "Restart Audio", "WirePlumber, PipeWire, pipewire-pulse", el=6,
                              info="Restarts the whole sound stack. Fixes stuck Bluetooth, missing devices and "
                                   "crackling. Every app reconnects within a second or two; your enchantments are re-applied.")
        self.gbutton("restart", x1 - 190, cy - 20, 190, 40, "Restart", lambda: self.ask(
            "Restart the sound stack?", "All audio stops for a moment while WirePlumber, PipeWire and pipewire-pulse "
            "restart. Saved enchantments are re-applied afterwards.", "Restart", self.restart_stack), glyph="restart", dark=True)
        y += 62
        x0, x1, cy = self.row(y, "Re-apply Enchantments", "EQ, Mono, Co-op, Clear Voice, clock", el=6,
                              info="Brings back everything that lives inside the server. Add "
                                   "'exec-once = irminsul-settings --restore' to hyprland.conf to do this at login.")
        self.gbutton("reapply", x1 - 190, cy - 20, 190, 40, "Re-apply",
                     lambda: POOL.submit(lambda: (restore_all(), self.host.idle(lambda: (self.toast("Enchantments re-applied"), self.refresh())))),
                     dark=True)
        y += 62
        mods = st.get("mods", [])
        y = self.section(y, "Loaded Modules", f"{len(mods)} loaded")
        for m in mods:
            mine = "irminsul" in m["arg"]
            x0, x1, cy = self.row(y, m["name"], m["arg"] or "no arguments", el=0 if mine else 6,
                                  info=("Loaded by Irminsul. " if mine else "") + "A server module. Unloading one removes "
                                       "whatever it created (a virtual device, a loopback...). Core modules may reload themselves.",
                                  cw=150)
            if mine:
                diamond(cr := self.cr, x0 - 6, cy, 4); A(cr, EL[0][1]); cr.fill()
            self.gbutton(f"unl:{m['idx']}", x1 - 130, cy - 18, 130, 36, "Unload", lambda m=m: self.ask(
                f"Unload {m['name']}?", "Whatever this module created will disappear right away.", "Unload",
                lambda: self.do(["pactl", "unload-module", str(m["idx"])], f"{m['name']} unloaded")), glyph="x", dark=True)
            y += 62
        return y

    RESTART_SUB = {
        "outputs": "Missing, silent or stuck output devices",
        "inputs": "Microphone gone, silent or crackling",
        "streams": "Apps stuck on the wrong device or not showing",
        "profiles": "Bluetooth stuck, or a profile is missing",
