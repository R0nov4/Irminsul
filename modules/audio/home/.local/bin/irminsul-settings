    "follow_streams": True, "chime_on_switch": False, "show_mic": True, "show_apps": True, "reduced_motion": False,
    "eq": {"enabled": False, "preset": "Flat", "gains": [0] * 10, "preamp": 0.0, "q": 1.0, "target": ""},
