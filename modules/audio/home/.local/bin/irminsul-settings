    def reset_all(self):
        self.cfg = _merge(DEFAULTS, {}); save_cfg(self.cfg); self.toast("Everything is back to default")
        self.rt.pop("coop_sel", None); self.rt.pop("coop_sync", None)

    def page_night(self, y):
        n = self.cfg["night"]; night = self.rt.get("night")
        y = self.night_canvas(y, n, night)
        mi = NIGHT_MIN.index(n["minutes"]) if n["minutes"] in NIGHT_MIN else 3

        def setm(j):
            n["minutes"] = NIGHT_MIN[j % len(NIGHT_MIN)]; self.save()
        x0, x1, cy = self.row(y, "Duration", el=3, info="How long until the music is fully faded.")
        self.selector("nmin", x0, x1, cy, f"{n['minutes']} minutes", lambda: setm(mi - 1), lambda: setm(mi + 1))
        y += 62
        ci = n["curve"]
        x0, x1, cy = self.row(y, "Fade Curve", el=3, info="Linear drops evenly. Gentle falls fast first, then lingers "
                              "quietly. Lullaby keeps the music full for most of the watch, then fades at the end.")
        self.selector("ncur", x0, x1, cy, NIGHT_CURVE[ci], lambda: (n.__setitem__("curve", (ci - 1) % 3), self.save()),
                      lambda: (n.__setitem__("curve", (ci + 1) % 3), self.save()))
        y += 62
        ai = n["action"]
        x0, x1, cy = self.row(y, "When It Ends", el=3, info="Pausing uses playerctl (Spotify, browsers, mpv...). The "
                              "volume is always restored afterwards, so the morning alarm is not silent.")
        self.selector("nend", x0, x1, cy, NIGHT_END[ai], lambda: (n.__setitem__("action", (ai - 1) % 3), self.save()),
                      lambda: (n.__setitem__("action", (ai + 1) % 3), self.save()))
        y += 62
        x0, x1, cy = self.row(y, "Keep Watch", "Runs even after you close this window", el=3,
                              info="The watch is a tiny background process. Close the archive, lock the screen: it "
                                   "keeps fading. Stop it here any time.")
        if night:
            self.gbutton("nstop", x1 - 200, cy - 20, 200, 40, "End the watch", self.night_stop, glyph="x", dark=True)
        else:
            self.gbutton("nstart", x1 - 200, cy - 20, 200, 40, "Begin the watch", self.night_start, glyph="moon", dark=True)
        return y + 62

    def night_canvas(self, y, n, night):
        cr, x, w = self.cr, self.CX0, self.RW; h = 280
        rrect(cr, x, y, w, h, 14)
        g = cairo.LinearGradient(0, y, 0, y + h); g.add_color_stop_rgb(0, 0.10, 0.11, 0.19); g.add_color_stop_rgb(1, 0.17, 0.16, 0.27)
        cr.set_source(g); cr.fill_preserve(); A(cr, GOLD, 0.3); cr.set_line_width(1); cr.stroke()
        rng = random.Random(11)
        for _ in range(46):
            sx, sy = x + 14 + rng.random() * (w - 28), y + 14 + rng.random() * (h - 28); ph = rng.random() * 6
            star(cr, sx, sy, 1.5 + rng.random() * 2.6, 0.3); A(cr, IVORY, 0.12 + 0.25 * (0.5 + 0.5 * math.sin(self.t * 1.3 + ph))); cr.fill()
        cx, cy, R = x + w * 0.38, y + h / 2, 100
        now = time.time()
        if night:
            f = min(1.0, (now - night["start"]) / night["dur"]); rem = max(0, night["start"] + night["dur"] - now)
        else:
            f, rem = 0.0, n["minutes"] * 60
        cr.set_line_width(12); A(cr, NAVY3, 0.8); cr.new_path(); cr.arc(cx, cy, R, 0, 2 * math.pi); cr.stroke()
        a0 = -math.pi / 2; a1 = a0 + (1 - f) * 2 * math.pi
        if 1 - f > 0.002:
            gl = cairo.LinearGradient(cx - R, cy - R, cx + R, cy + R)
            gl.add_color_stop_rgb(0, *EL[3][1]); gl.add_color_stop_rgb(1, *EL[5][1])
            cr.set_source(gl); cr.set_line_cap(cairo.LINE_CAP_ROUND); cr.new_path(); cr.arc(cx, cy, R, a0, a1); cr.stroke()
        for i in range(12):
            a = i * math.pi / 6
            diamond(cr, cx + (R + 18) * math.cos(a), cy + (R + 18) * math.sin(a), 2.6 if i % 3 else 4); A(cr, GOLD, 0.6); cr.fill()
        px, py = cx + R * math.cos(a1), cy + R * math.sin(a1)
        star(cr, px, py, 11, 0.22, self.t * 0.5); A(cr, IVORY); cr.fill()
        mm, ss = int(rem // 60), int(rem % 60)
        text(cr, f"{mm}:{ss:02d}" if night else f"{n['minutes']} min", cx, cy - 8, 38, IVORY, bold=True, anchor="c")
        text(cr, "until the music sleeps" if night else "ready to keep watch", cx, cy + 26, 13, GOLD, anchor="c")
        if night:
            text(cr, f"volume now {int(night['v0'] * night_curve(night['curve'], f))}%", cx, cy + 46, 12.5, IVORY, 0.6, anchor="c")
        gx0, gx1, gy0, gy1 = x + w * 0.66, x + w - 34, y + 66, y + h - 70
        text(cr, "Fade curve", gx0, y + 40, 13, GOLD_HI, bold=True)
        cr.set_line_width(1); A(cr, GOLD, 0.25); cr.move_to(gx0, gy1); cr.line_to(gx1, gy1); cr.move_to(gx0, gy0); cr.line_to(gx0, gy1); cr.stroke()
        c = night["curve"] if night else n["curve"]
        cr.set_line_width(2.4); A(cr, EL[5][1])
        for k in range(41):
            fx_ = gx0 + (gx1 - gx0) * k / 40; fy = gy1 - (gy1 - gy0) * night_curve(c, k / 40)
            (cr.move_to if k == 0 else cr.line_to)(fx_, fy)
        cr.stroke()
        dx, dy_ = gx0 + (gx1 - gx0) * f, gy1 - (gy1 - gy0) * night_curve(c, f)
        diamond(cr, dx, dy_, 6); A(cr, IVORY); cr.fill()
        text(cr, "now", gx0, gy1 + 18, 12, IVORY, 0.5); text(cr, "asleep", gx1, gy1 + 18, 12, IVORY, 0.5, anchor="r")
        icon(cr, "moon", x + 54, y + 50, 34, GOLD, 0.7)
        return y + h + 12

    # ── frame ──
    def draw(self, cr, W, H):
        self.cr, self.W, self.H = cr, W, H
        self.hits, self._info, self.modal = [], None, False
        self.INFO_W = 340 if W >= 1240 else 300
        self.IX0 = W - self.INFO_W - 34
        self.CX0 = 292; self.CX1 = self.IX0 - 24; self.RW = self.CX1 - self.CX0 - 14
        self.TOP, self.BOT = 120, H - 34
        self.clip = (0, 0, W, H)
        self.draw_bg()
        self.hit("move", 14, 14, W - 130, 92, ret="move")
        self.draw_header(); self.draw_nav()
        view = (self.CX0 - 8, self.TOP, self.CX1 - self.CX0 + 8, self.BOT - self.TOP); self.view = view
        cr.save(); cr.rectangle(*view); cr.clip(); self.clip = view
        e = 1 - (1 - min(1.0, self.page_t / 0.24)) ** 3
        sliding = e < 0.999
        if sliding:
            cr.push_group(); cr.translate((1 - e) * 22, 0)
        y0 = self.TOP + 2 - self.scroll_s.get(self.page, 0)
        yend = getattr(self, "page_" + self.page)(y0)
        if self.page in self.RESTART_SUB:
            yend = self.maint_row(yend)
        self.content_h[self.page] = yend - y0
        if sliding:
            cr.pop_group_to_source(); cr.paint_with_alpha(e)
        cr.restore(); self.clip = (0, 0, W, H)
        ch, vh = self.content_h[self.page], view[3]
        if ch > vh + 4:
            sx = self.CX1 - 4; frac = vh / ch; th = max(40, vh * frac)
            ty = self.TOP + (vh - th) * (self.scroll_s.get(self.page, 0) / max(1, ch - vh + 24))
            rrect(cr, sx, self.TOP, 4, vh, 2); A(cr, NAVY3, 0.5); cr.fill()
            rrect(cr, sx, ty, 4, th, 2); A(cr, GOLD_LO, 0.9); cr.fill()
        self.draw_info()
        self.draw_toast()
        if self.dialog:
            self.draw_dialog()
        self.info = self._info

    def draw_bg(self):
        cr, W, H = self.cr, self.W, self.H
        x, y, pw, ph = 10, 8, W - 20, H - 18
        if getattr(self, "_bg_key", None) != (W, H):
            surf = cr.get_target().create_similar(cairo.CONTENT_COLOR_ALPHA, W, H); c2 = cairo.Context(surf)
            for i in range(8):
                rrect(c2, x - i, y - i + 4, pw + 2 * i, ph + 2 * i, 22 + i); A(c2, (0, 0, 0), 0.05); c2.fill()
            rrect(c2, x, y, pw, ph, 22)
            g = cairo.LinearGradient(0, y, 0, y + ph); g.add_color_stop_rgb(0, 0.205, 0.228, 0.305); g.add_color_stop_rgb(1, 0.13, 0.145, 0.205)
            c2.set_source(g); c2.fill_preserve(); A(c2, GOLD, 0.95); c2.set_line_width(1.8); c2.stroke()
            self._bg_surf, self._bg_key = surf, (W, H)
        cr.set_operator(cairo.OPERATOR_SOURCE); cr.set_source_surface(self._bg_surf, 0, 0); cr.paint(); cr.set_operator(cairo.OPERATOR_OVER)
        # Irminsul watermark: a slow astrolabe behind everything
        cx, cy, rot = W * 0.56, H * 0.6, self.t * (0.008 if self.cfg["reduced_motion"] else 0.02)
        cr.save(); rrect(cr, x, y, pw, ph, 22); cr.clip()
        for r, al in ((380, 0.05), (330, 0.035), (250, 0.05), (160, 0.03)):
            cr.set_line_width(1); A(cr, GOLD, al); cr.new_path(); cr.arc(cx, cy, r, 0, 2 * math.pi); cr.stroke()
        for i in range(96):
            a = rot + i * math.pi / 48; ln = 14 if i % 8 == 0 else 6
            cr.move_to(cx + 380 * math.cos(a), cy + 380 * math.sin(a)); cr.line_to(cx + (380 - ln) * math.cos(a), cy + (380 - ln) * math.sin(a))
        A(cr, GOLD, 0.05); cr.stroke()
        star(cr, cx, cy, 330, 0.08, -rot * 1.5); A(cr, GOLD, 0.025); cr.fill()
        star(cr, cx, cy, 250, 0.1, rot * 2 + math.pi / 4); A(cr, GOLD, 0.02); cr.fill()
        rng = random.Random(7)
        for _ in range(40):
            sx, sy = x + 18 + rng.random() * (pw - 36), y + 18 + rng.random() * (ph - 36); ph_ = rng.random() * 6
            star(cr, sx, sy, 2 + rng.random() * 3.2, 0.25)
            A(cr, GOLD, 0.04 + 0.07 * (0.5 + 0.5 * math.sin(self.t * 0.9 + ph_))); cr.fill()
        cr.restore()
        rrect(cr, x + 7, y + 7, pw - 14, ph - 14, 16); A(cr, GOLD, 0.28); cr.set_line_width(1); cr.stroke()
        for cx_, cy_ in ((x + 7, y + 7), (x + pw - 7, y + 7), (x + 7, y + ph - 7), (x + pw - 7, y + ph - 7)):
            diamond(cr, cx_, cy_, 4.6); A(cr, NAVY); cr.fill_preserve(); A(cr, GOLD); cr.set_line_width(1.2); cr.stroke()
        mx = x + pw / 2
        for dx in (-18, 18):
            diamond(cr, mx + dx, y, 2.6); A(cr, GOLD); cr.fill()
        diamond(cr, mx, y, 6.5); A(cr, NAVY); cr.fill_preserve(); A(cr, GOLD); cr.set_line_width(1.4); cr.stroke()
        # rail between navigation and content
        g = cairo.LinearGradient(0, 120, 0, H - 40)
        g.add_color_stop_rgba(0, GOLD[0], GOLD[1], GOLD[2], 0); g.add_color_stop_rgba(0.5, GOLD[0], GOLD[1], GOLD[2], 0.35)
        g.add_color_stop_rgba(1, GOLD[0], GOLD[1], GOLD[2], 0); cr.set_source(g); cr.set_line_width(1)
        cr.move_to(274, 120); cr.line_to(274, H - 40); cr.stroke()

    def draw_header(self):
        cr, W = self.cr, self.W
        cy = 62
        g = cairo.RadialGradient(60, cy, 0, 60, cy, 34)
        g.add_color_stop_rgba(0, GOLD[0], GOLD[1], GOLD[2], 0.35); g.add_color_stop_rgba(1, GOLD[0], GOLD[1], GOLD[2], 0)
        cr.set_source(g); cr.new_path(); cr.arc(60, cy, 34, 0, 2 * math.pi); cr.fill()
        icon(cr, "gear", 60, cy, 34, GOLD_HI)
        star(cr, 60, cy, 7, 0.25, self.t * 0.5); A(cr, GOLD_HI); cr.fill()
        text(cr, "Settings", 96, cy - 10, 30, IVORY, bold=True)
        text(cr, "The Resonance Archive  ·  Irminsul", 98, cy + 20, 13, GOLD, 0.9)
        ck = self.st.get("clock", {}); info = self.st.get("info", {})
        try:
            rate = int(float(ck.get("clock.force-rate") or 0) or float(ck.get("clock.rate") or 48000))
            q = int(float(ck.get("clock.force-quantum") or 0) or float(ck.get("clock.quantum") or 1024))
        except ValueError:
            rate, q = 48000, 1024
        srv = info.get("server_name", "")
        m = re.search(r"PipeWire ([\d.]+)", srv)
        srv = f"PipeWire {m.group(1)}" if m else ("PulseAudio" if srv else "Connecting…")
        lab = f"{srv}   ·   {rate / 1000:g} kHz   ·   {q / rate * 1000:.1f} ms"
        tw = measure(cr, lab, 13) + 40; px = W - 104 - tw
        rrect(cr, px, cy - 17, tw, 34, 17); A(cr, DEEP, 0.5); cr.fill_preserve(); A(cr, GOLD, 0.35); cr.set_line_width(1); cr.stroke()
        cr.new_path(); cr.arc(px + 18, cy, 4, 0, 2 * math.pi); A(cr, EL[4][1], 0.6 + 0.4 * math.sin(self.t * 2.4)); cr.fill()
        text(cr, lab, px + 30, cy, 13, IVORY, 0.8)
        hov = self.over(W - 82, cy - 24, 48, 48)
        cr.new_path(); cr.arc(W - 58, cy, 22, 0, 2 * math.pi); A(cr, GOLD, 0.25 if hov else 0.0); cr.fill_preserve()
        A(cr, GOLD_HI if hov else GOLD); cr.set_line_width(1.6); cr.stroke()
        cr.new_path(); cr.arc(W - 58, cy, 17, 0, 2 * math.pi); A(cr, GOLD, 0.35); cr.set_line_width(1); cr.stroke()
        icon(cr, "close", W - 58, cy, 22, GOLD_HI)
        self.hit("close", W - 82, cy - 24, 48, 48, press=lambda *_: self.host.close())

    def draw_nav(self):
        cr = self.cr; x, w, h, gap = 34, 226, 58, 6; y0 = self.TOP
        sel = PAGE_IDS.index(self.page); ty = y0 + sel * (h + gap)
        self.nav_y = ty if self.nav_y is None else self.nav_y + (ty - self.nav_y) * min(1.0, self.dt * 16)
        ny = self.nav_y
        g = cairo.LinearGradient(x, 0, x + w, 0); g.add_color_stop_rgb(0, *IVORY); g.add_color_stop_rgb(1, *mix(IVORY, GOLD, 0.4))
        rrect(cr, x, ny, w, h, h / 2); cr.set_source(g); cr.fill_preserve(); A(cr, GOLD, 0.9); cr.set_line_width(1.2); cr.stroke()
        diamond(cr, x - 12, ny + h / 2, 5); A(cr, GOLD_HI); cr.fill()
        for i, (pid, title, sub, ic, el) in enumerate(NAV):
            yy = y0 + i * (h + gap); cy = yy + h / 2; on = i == sel
            near = abs(ny - yy) < h * 0.5
            hov = self.over(x, yy, w, h)
            if hov and not on:
                rrect(cr, x, yy, w, h, h / 2); A(cr, GOLD, 0.13); cr.fill()
            cr.new_path(); cr.arc(x + 30, cy, 20, 0, 2 * math.pi); A(cr, INK if near else NAVY2); cr.fill_preserve()
            A(cr, elc(el) if on else GOLD, 0.9 if on else 0.45); cr.set_line_width(1.4); cr.stroke()
            icon(cr, ic, x + 30, cy, 20, elc(el) if on else GOLD_HI)
            text(cr, title, x + 62, cy - 9, 15, INK if near else IVORY, bold=True, width=w - 74)
            text(cr, sub, x + 62, cy + 11, 12, INK if near else IVORY, 0.7 if near else 0.45, width=w - 74)
            self.hit(f"nav:{pid}", x, yy, w, h, press=lambda *_, p=pid: self.goto(p))

    def draw_info(self):
        cr = self.cr; x0, x1 = self.IX0, self.W - 34; y0, y1 = self.TOP - 2, self.H - 104; w = x1 - x0
        rrect(cr, x0, y0, w, y1 - y0, 16); A(cr, DEEP, 0.5); cr.fill_preserve(); A(cr, GOLD, 0.4); cr.set_line_width(1); cr.stroke()
        rrect(cr, x0 + 6, y0 + 6, w - 12, y1 - y0 - 12, 12); A(cr, GOLD, 0.12); cr.stroke()
        page = next(n for n in NAV if n[0] == self.page)
        title, desc, el = self.info or (page[1], PAGE_INFO[self.page], page[4])
        el = page[4] if el is None else el
        cx, ey = (x0 + x1) / 2, y0 + 82; c = elc(el); rot = self.t * 0.25
        g = cairo.RadialGradient(cx, ey, 10, cx, ey, 70)
        g.add_color_stop_rgba(0, c[0], c[1], c[2], 0.35); g.add_color_stop_rgba(1, c[0], c[1], c[2], 0)
        cr.set_source(g); cr.new_path(); cr.arc(cx, ey, 70, 0, 2 * math.pi); cr.fill()
        cr.set_line_width(1); A(cr, GOLD, 0.5); cr.new_path(); cr.arc(cx, ey, 54, 0, 2 * math.pi); cr.stroke()
        for i in range(48):
            a = rot + i * math.pi / 24; ln = 5 if i % 4 == 0 else 2.5
            cr.move_to(cx + 54 * math.cos(a), ey + 54 * math.sin(a)); cr.line_to(cx + (54 - ln) * math.cos(a), ey + (54 - ln) * math.sin(a))
        A(cr, GOLD, 0.5); cr.stroke()
        for i in range(4):
            a = -rot * 0.6 + i * math.pi / 2
            diamond(cr, cx + 62 * math.cos(a), ey + 62 * math.sin(a), 3.6); A(cr, c); cr.fill()
        cr.new_path(); cr.arc(cx, ey, 40, 0, 2 * math.pi); A(cr, NAVY); cr.fill_preserve(); A(cr, c, 0.9); cr.set_line_width(1.6); cr.stroke()
        icon(cr, page[3], cx, ey, 34, GOLD_HI)
        text(cr, title, cx, ey + 92, 20, IVORY, bold=True, anchor="c", width=w - 44)
        ly = ey + 118
        for side in (-1, 1):
            g = cairo.LinearGradient(cx, 0, cx + side * (w / 2 - 30), 0)
            g.add_color_stop_rgba(0, GOLD[0], GOLD[1], GOLD[2], 0.8); g.add_color_stop_rgba(1, GOLD[0], GOLD[1], GOLD[2], 0)
            cr.set_source(g); cr.move_to(cx + side * 10, ly); cr.line_to(cx + side * (w / 2 - 30), ly); cr.stroke()
        diamond(cr, cx, ly, 4.5); A(cr, c); cr.fill()
        para(cr, desc, x0 + 28, ly + 20, 14, IVORY, 0.82, w - 56)
        # ley line monitor
        my = y1 - 128
        rrect(cr, x0 + 18, my, w - 36, 110, 12); A(cr, NAVY2, 0.55); cr.fill_preserve(); A(cr, GOLD, 0.25); cr.stroke()
        text(cr, "Ley Line Monitor", x0 + 36, my + 24, 13.5, GOLD_HI, bold=True)
        text(cr, "Microphone" if self.an.target == "mic" else "Output", x1 - 36, my + 24, 12.5, IVORY, 0.55, anchor="r")
        n = 22; bx0, bx1 = x0 + 62, x1 - 36; seg = (bx1 - bx0) / n
        for s, yy in ((0, my + 56), (1, my + 82)):
            text(cr, "LR"[s], x0 + 40, yy, 13, GOLD, bold=True)
            for k in range(n):
                on = self.lv[s] * n > k; col = el_grad(k / (n - 1))
                rrect(cr, bx0 + k * seg, yy - 7, seg - 3, 14, 3); A(cr, col if on else NAVY3, 0.95 if on else 0.5); cr.fill()
        # footer buttons
        bw = (w - 12) / 2; by = self.H - 90
        self.gbutton("openmix", x0, by, bw, 46, "Mixer", self.open_mixer)
        self.gbutton("closeb", x0 + bw + 12, by, bw, 46, "Close", self.host.close, glyph="x")

    def draw_toast(self):
        age = self.t - self.toast_t
        if age > 3.4 or not self.toast_msg:
            return
        cr = self.cr; a = min(1.0, age / 0.15, (3.4 - age) / 0.4)
        tw = measure(cr, self.toast_msg, 14, True) + 70; cx = (self.CX0 + self.CX1) / 2
        x, y = cx - tw / 2, self.H - 84 + (1 - a) * 10
        rrect(cr, x, y, tw, 42, 21); A(cr, IVORY, 0.97 * a); cr.fill_preserve(); A(cr, GOLD_LO, a); cr.set_line_width(1.2); cr.stroke()
        star(cr, x + 24, y + 21, 9, 0.22, self.t); A(cr, GOLD_LO, a); cr.fill()
        text(cr, self.toast_msg, x + 42, y + 21, 14, INK, a, bold=True)

    def draw_dialog(self):
        cr, W, H, d = self.cr, self.W, self.H, self.dialog
        a = 1 - (1 - min(1.0, (self.t - self.dialog_t) / 0.2)) ** 3
        rrect(cr, 10, 8, W - 20, H - 18, 22); A(cr, DEEP, 0.66 * a); cr.fill()
        self.modal = True
        bw, bh = 600, 290; bx, by = (W - bw) / 2, (H - bh) / 2 + (1 - a) * 18
        rrect(cr, bx, by, bw, bh, 16)
        g = cairo.LinearGradient(0, by, 0, by + bh); g.add_color_stop_rgb(0, *IVORY); g.add_color_stop_rgb(1, *mix(IVORY, GOLD, 0.3))
        cr.set_source(g); cr.fill_preserve(); A(cr, GOLD_LO); cr.set_line_width(2); cr.stroke()
        rrect(cr, bx + 8, by + 8, bw - 16, bh - 16, 11); A(cr, GOLD_LO, 0.45); cr.set_line_width(1); cr.stroke()
        for cx_, cy_ in ((bx + 8, by + 8), (bx + bw - 8, by + 8), (bx + 8, by + bh - 8), (bx + bw - 8, by + bh - 8)):
            diamond(cr, cx_, cy_, 4.5); A(cr, INK); cr.fill()
        star(cr, W / 2, by + 36, 12, 0.22, self.t * 0.4); A(cr, GOLD_LO); cr.fill()
        text(cr, d["title"], W / 2, by + 72, 21, INK, bold=True, anchor="c", width=bw - 60)
        for side in (-1, 1):
            g = cairo.LinearGradient(W / 2, 0, W / 2 + side * 220, 0)
            g.add_color_stop_rgba(0, GOLD_LO[0], GOLD_LO[1], GOLD_LO[2], 0.9); g.add_color_stop_rgba(1, GOLD_LO[0], GOLD_LO[1], GOLD_LO[2], 0)
            cr.set_source(g); cr.set_line_width(1); cr.move_to(W / 2 + side * 8, by + 98); cr.line_to(W / 2 + side * 220, by + 98); cr.stroke()
        diamond(cr, W / 2, by + 98, 4); A(cr, GOLD_LO); cr.fill()
        para(cr, d["msg"], bx + 56, by + 116, 14.5, INK, 0.85, bw - 112)
        self.hit("dlg", bx, by, bw, bh, press=lambda *_: None)

        def ok():
            self.dialog = None; d["on_ok"]()
        self.gbutton("dcancel", bx + 50, by + bh - 76, 230, 48, "Cancel", lambda: setattr(self, "dialog", None), glyph="x", dark=True)
        self.gbutton("dok", bx + bw - 280, by + bh - 76, 230, 48, d["ok"], ok, glyph="o", dark=True)
        self.modal = False


# ───────────────────────────── GTK host ─────────────────────────────
class Watcher(threading.Thread):
    def __init__(self, cb):
        super().__init__(daemon=True); self.cb = cb; self.proc = None; self.stop = False

    def run(self):
        if DEMO:
            return
        while not self.stop:
            try:
                self.proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
                for line in self.proc.stdout:
                    if any(k in line for k in ("sink", "source", "server", "card", "module")) and "source-output" not in line:
                        GLib.idle_add(self.cb)
            except Exception:
                pass
            time.sleep(1)

    def close(self):
        self.stop = True
        try:
            self.proc.terminate()
        except Exception:
            pass


if not PREVIEW:
    class Window(Gtk.ApplicationWindow):
        def __init__(self, app, page):
            super().__init__(application=app, title="Irminsul Settings")
            self.set_decorated(False); self.set_app_paintable(True)
            scr = self.get_screen(); vis = scr.get_rgba_visual()
            if vis is not None and scr.is_composited():
                self.set_visual(vis)
            W, H = 1320, 860
            try:
                mon = Gdk.Display.get_default().get_monitor(0).get_geometry()
                W, H = min(W, mon.width - 60), min(H, mon.height - 60)
            except Exception:
                pass
            _a = (Gdk.Display.get_default().get_primary_monitor() or Gdk.Display.get_default().get_monitor(0)).get_workarea(); self.set_default_size(min(max(1080, W), int(_a.width * 0.94)), min(max(660, H), int(_a.height * 0.9))); self.set_size_request(min(1080, int(_a.width * 0.5)), min(660, int(_a.height * 0.6)))
            self.icons = {}
            self.scene = Scene(self, page)
            self.area = Gtk.DrawingArea(); self.area.set_can_focus(True)
            self.area.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK |
                                 Gdk.EventMask.POINTER_MOTION_MASK | Gdk.EventMask.SCROLL_MASK |
                                 Gdk.EventMask.SMOOTH_SCROLL_MASK | Gdk.EventMask.LEAVE_NOTIFY_MASK)
            self.area.connect("draw", lambda w, cr: (self.scene.draw(cr, w.get_allocated_width(), w.get_allocated_height()), False)[1])
            self.area.connect("button-press-event", self.on_press)
            self.area.connect("button-release-event", lambda w, e: self.scene.on_release(e.x, e.y))
            self.area.connect("motion-notify-event", lambda w, e: self.scene.on_motion(e.x, e.y))
            self.area.connect("leave-notify-event", lambda w, e: self.scene.on_leave())
            self.area.connect("scroll-event", self.on_scroll)
            self.connect("key-press-event", lambda w, e: (self.scene.on_key(Gdk.keyval_name(e.keyval) or ""), True)[1])
            self.connect("destroy", lambda *_: (self.scene.close(), self.watcher.close()))
            self.add(self.area)
            self.watcher = Watcher(self.scene.on_event); self.watcher.start()
            self.last = time.monotonic(); self.opened = self.last; self.set_opacity(0.0)
            GLib.timeout_add(33, self.tick)

        def tick(self):
            now = time.monotonic(); dt = min(0.25, now - self.last); self.last = now
            sc = self.scene
            self._f = getattr(self, "_f", 0) + 1
            busy = (now - sc.last_input < 1.5 or sc.page_t < 0.6 or sc.dialog or sc.active
                    or sc.page == "astro" or now - self.opened < 0.5 or now - sc.toast_t_wall < 2.5)
            if busy or self._f % 3 == 0:
                sc.tick(dt); self.area.queue_draw()
            else:
                self.last = now - dt            # keep accumulating time so animations stay in sync
            age = now - self.opened
            if self.get_opacity() < 1.0:
                self.set_opacity(min(1.0, age / 0.22))
            return True

        def on_press(self, w, e):
            if e.type != Gdk.EventType.BUTTON_PRESS:
                return True
            if self.scene.on_press(e.x, e.y, e.button) == "move":
                self.begin_move_drag(e.button, int(e.x_root), int(e.y_root), e.time)
            return True

        def on_scroll(self, w, e):
            if e.direction == Gdk.ScrollDirection.UP:
                dy = -1
            elif e.direction == Gdk.ScrollDirection.DOWN:
                dy = 1
            else:
                dy = e.get_scroll_deltas()[2]
                if abs(dy) < 0.01:
                    return True
            self.scene.on_scroll(e.x, e.y, dy); return True

        # host interface
        def idle(self, fn):
            GLib.idle_add(lambda: (fn(), False)[1])

        def close(self):
            self.destroy()

        def app_icon(self, cr, names, cx, cy, size):
            key = (tuple(names), size)
            if key not in self.icons:
                pix = None; theme = Gtk.IconTheme.get_default()
                for n in names:
                    try:
                        if theme.has_icon(n):
                            pix = theme.load_icon(n, size, 0); break
                    except Exception:
                        pass
                self.icons[key] = pix
            pix = self.icons[key]
            if pix is None:
                return False
            Gdk.cairo_set_source_pixbuf(cr, pix, cx - pix.get_width() / 2, cy - pix.get_height() / 2); cr.paint()
            return True

    class App(Gtk.Application):
        def __init__(self):
            super().__init__(application_id="io.irminsul.Settings", flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
            self.win = None

        def do_command_line(self, cl):
            args = cl.get_arguments()[1:]; page = None
            if "--page" in args and args.index("--page") + 1 < len(args):
                page = args[args.index("--page") + 1]
            if self.win is None:
                self.win = Window(self, page or "outputs"); self.win.show_all()
            elif page in PAGE_IDS:
                self.win.scene.goto(page)
            self.win.present()
            return 0


def main():
    a = sys.argv[1:]
    if "--coop-control" in a:
        i = a.index("--coop-control")
        if i + 1 >= len(a) or a[i + 1] not in ("toggle", "pick"):
            print(json.dumps(dict(ok=False, message="Invalid Co-op action"))); return
        name = a[i + 2] if i + 2 < len(a) else None
        print(json.dumps(coop_control(a[i + 1], name))); return
    if "--restore" in a:
        restore_all(); return
    if "--night-watch" in a:
        i = a.index("--night-watch"); night_watch(float(a[i + 1]), int(a[i + 2]), int(a[i + 3])); return
    if PREVIEW:
        return
    GLib.set_prgname("irminsul-settings")
    prov = Gtk.CssProvider(); prov.load_from_data(b"window { background: transparent; }")
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    app = App()
    signal.signal(signal.SIGINT, lambda *_: app.quit())
    app.run([sys.argv[0]] + [x for x in a if x != "--demo"])


if __name__ == "__main__":
    main()
