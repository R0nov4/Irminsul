#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
 ✦ genshin-scale ✦ — automatic UI scaling for the Genshin desktop
 ================================================================
 Nothing is hand-tuned per screen any more.  The design is written ONCE for a
 reference screen (1600 logical px wide) in the *.base files, and this tool
 derives everything else from the real monitor:

   apply   reads `hyprctl monitors`, works out the LOGICAL width (pixels / scale),
           and from the base files generates

               ~/.config/waybar-genshin/style.css      (every px value × factor)
               ~/.config/waybar-genshin/config.jsonc   (height, margins, spacing × factor,
                                                        + fewer modules on narrow screens)

           then tells Waybar to reload (SIGUSR2) if anything changed.

   watch   = apply, then stay alive: re-applies when a monitor is plugged / unplugged /
           the config is reloaded / the resolution or scale changes, and keeps every
           FLOATING window on the screen: file-chooser dialogs (see POPUP_CLASSES) are made
           compact and centred, any other floating window that is too big or sticks out of
           the free area (below the bar) is shrunk / moved back inside it.

   status  prints what it sees and what it would do.

 Files (source of truth = the *.base files, never edit the generated ones):
     ~/.config/waybar-genshin/style.base.css
     ~/.config/waybar-genshin/config.base.jsonc

 First run: if the .base files do not exist yet, the current style.css / config.jsonc
 are copied to them (once), so nothing is lost.

 Manual override (for testing):   genshin-scale apply --scale 0.9
 Debug popups (shows class/title of every new window):   genshin-scale watch -v
"""
import argparse
import json
import os
import re
import select
import shutil
import socket
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
WAYBAR_DIR = os.environ.get("GENSHIN_WAYBAR_DIR", os.path.join(HOME, ".config", "waybar-genshin"))
BASE_CSS = os.path.join(WAYBAR_DIR, "style.base.css")
BASE_CFG = os.path.join(WAYBAR_DIR, "config.base.jsonc")
OUT_CSS = os.path.join(WAYBAR_DIR, "style.css")
OUT_CFG = os.path.join(WAYBAR_DIR, "config.jsonc")
MARK = "GENERATED by genshin-scale"

# ══════════════════════════════════════════════════════════ knobs ══
REF_WIDTH = 1600                 # logical width the base files were designed for (the laptop: 1600x900)
SCALE_MIN, SCALE_MAX = 0.80, 1.50
SCALE_STEP = 0.05                # factor is snapped to this, so tiny changes never reload the bar
FONT_FLOOR = 10                  # never make text smaller than this (px)

# narrow screens: (logical width below which -> modules removed from the bar), narrowest first
TIERS = [
    (1000, ["hyprland/window", "custom/ping", "cpu", "memory"]),
    (1200, ["hyprland/window", "custom/ping"]),
    (1500, ["hyprland/window"]),
]

# dialogs (file choosers ...) are made compact: at most this share of the free area, centred
POPUP_CLASSES = ("xdg-desktop-portal-gtk", "zenity", "org.gnome.Zenity")
POPUP_FRACTION = (0.70, 0.78)    # max share of the free area (width, height)
# ANY other floating window that does not fit on the screen is pulled back inside it
SAFE_FRACTION = 0.96

# numeric keys in the Waybar config that are lengths in px
GEOM_KEYS = {"height", "spacing", "icon-size", "margin",
             "margin-top", "margin-bottom", "margin-left", "margin-right"}


# ═════════════════════════════════════════════════════ hyprland ══
def hyprctl_json(*args):
    r = subprocess.run(["hyprctl", "-j", *args], capture_output=True, text=True, timeout=4)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "hyprctl failed")
    return json.loads(r.stdout)


def logical_size(m):
    """Monitor size in LOGICAL px (what GTK / Waybar / windows actually live in)."""
    w, h = float(m["width"]), float(m["height"])
    if int(m.get("transform", 0)) % 2 == 1:          # rotated 90° / 270°
        w, h = h, w
    s = float(m.get("scale") or 1.0)
    return w / s, h / s


def narrowest_monitor(mons):
    live = [m for m in mons if not m.get("disabled")]
    if not live:
        raise RuntimeError("no active monitor")
    return min(live, key=lambda m: logical_size(m)[0])


# ═════════════════════════════════════════════════════ maths ══
def compute_factor(width):
    f = width / REF_WIDTH
    f = max(SCALE_MIN, min(SCALE_MAX, f))
    return round(round(f / SCALE_STEP) * SCALE_STEP, 2)


def modules_to_drop(width):
    for limit, drop in TIERS:
        if width < limit:
            return drop
    return []


def rnd(x):
    return int(x + 0.5) if x >= 0 else -int(-x + 0.5)


def fmt(x):
    return str(int(x)) if abs(x - round(x)) < 1e-9 else ("%g" % x)


def scale_one(prop, v, f):
    """Scale one px length of a CSS property."""
    if v == 0:
        return 0
    if prop == "font-size":
        if v <= 1.5:                                  # the "hide the text" hack (font-size: 1px)
            return v
        return max(min(v, FONT_FLOOR), rnd(v * f))
    if prop.startswith("border") and "radius" not in prop:
        return max(min(v, 1), rnd(v * f * 2) / 2)    # hairlines stay ≥ 1px, steps of 0.5
    return max(min(v, 1), rnd(v * f))


PX = re.compile(r"(?<![\w.#])(\d+(?:\.\d+)?)px\b")
DECL = re.compile(r"(?P<prop>[a-zA-Z-]+)(?P<sep>\s*:\s*)(?P<val>[^;{}]*)(?=[;}])")


def scale_css(text, f):
    def decl(m):
        prop = m.group("prop").lower()
        val = PX.sub(lambda p: fmt(scale_one(prop, float(p.group(1)), f)) + "px", m.group("val"))
        return m.group("prop") + m.group("sep") + val
    return DECL.sub(decl, text)


def strip_jsonc(s):
    """Remove // and /* */ comments and trailing commas (outside of strings)."""
    out, i, n, in_str = [], 0, len(s), False
    while i < n:
        c = s[i]
        if in_str:
            out.append(c)
            if c == "\\" and i + 1 < n:
                out.append(s[i + 1]); i += 2; continue
            if c == '"':
                in_str = False
            i += 1; continue
        if c == '"':
            in_str = True; out.append(c); i += 1; continue
        if c == "/" and s[i + 1:i + 2] == "/":
            while i < n and s[i] != "\n":
                i += 1
            continue
        if c == "/" and s[i + 1:i + 2] == "*":
            j = s.find("*/", i + 2)
            i = n if j < 0 else j + 2
            continue
        if c == ",":
            j = i + 1
            while j < n and s[j] in " \t\r\n":
                j += 1
            if j < n and s[j] in "}]":
                i += 1; continue
        out.append(c); i += 1
    return "".join(out)


def scale_config(text, f, drop):
    cfg = json.loads(strip_jsonc(text))

    def walk(o):
        if isinstance(o, dict):
            for k, v in list(o.items()):
                if k in GEOM_KEYS and isinstance(v, (int, float)) and not isinstance(v, bool):
                    o[k] = 0 if v == 0 else max(1, rnd(v * f))
                else:
                    walk(v)
        elif isinstance(o, list):
            for x in o:
                walk(x)
    walk(cfg)

    def prune(bar):
        if not isinstance(bar, dict):
            return
        for k, v in list(bar.items()):
            if k.startswith("modules-") and isinstance(v, list):
                bar[k] = [m for m in v if m not in drop]
            elif isinstance(v, dict) and isinstance(v.get("modules"), list):
                v["modules"] = [m for m in v["modules"] if m not in drop]
    for bar in (cfg if isinstance(cfg, list) else [cfg]):
        prune(bar)
    return cfg


# ═════════════════════════════════════════════════════ apply ══
def write_if_changed(path, text):
    try:
        with open(path, encoding="utf-8") as fh:
            if fh.read() == text:
                return False
    except FileNotFoundError:
        pass
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)
    return True


def bootstrap_base():
    for base, live in ((BASE_CSS, OUT_CSS), (BASE_CFG, OUT_CFG)):
        if os.path.exists(base):
            continue
        if not os.path.exists(live):
            raise RuntimeError("missing %s (and no %s to start from)" % (base, live))
        with open(live, encoding="utf-8") as fh:
            if MARK in fh.read(400):
                raise RuntimeError("%s is generated but %s is missing - restore the base file" % (live, base))
        shutil.copy2(live, base)
        print("genshin-scale: first run - saved %s as %s" % (os.path.basename(live), os.path.basename(base)))


def read_monitors(mon_json):
    if mon_json:
        with open(mon_json, encoding="utf-8") as fh:
            return json.load(fh)
    return hyprctl_json("monitors")


def apply(mon_json=None, force=None, dry=False, quiet=False):
    mons = read_monitors(mon_json)
    m = narrowest_monitor(mons)
    lw, lh = logical_size(m)
    f = float(force) if force else compute_factor(lw)
    drop = [] if force else modules_to_drop(lw)
    head = "scale=%s  logical=%dx%d  monitor=%s  dropped=%s" % (
        fmt(f), lw, lh, m.get("name", "?"), ",".join(drop) or "-")
    if dry:                                   # `status`: look, don't touch anything
        print(head)
        return False

    bootstrap_base()
    with open(BASE_CSS, encoding="utf-8") as fh:
        css = scale_css(fh.read(), f)
    with open(BASE_CFG, encoding="utf-8") as fh:
        cfg = scale_config(fh.read(), f, drop)

    css_out = "/* %s (%s) - edit style.base.css, not this file */\n%s" % (MARK, head, css)
    cfg_out = "// %s (%s) - edit config.base.jsonc, not this file\n%s\n" % (
        MARK, head, json.dumps(cfg, indent=4, ensure_ascii=False))

    changed = write_if_changed(OUT_CSS, css_out)
    changed = write_if_changed(OUT_CFG, cfg_out) or changed
    if not quiet:
        print("genshin-scale:", head, "->", "updated" if changed else "unchanged")
    if changed:
        subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"], stderr=subprocess.DEVNULL)
    return changed


# ═════════════════════════════════════════════════════ popups ══
def fit_popup(addr, verbose=False):
    """Shrink a floating window so it fits in the free area of its monitor, and centre it."""
    want = ("0x" + addr).lower()
    c = next((c for c in hyprctl_json("clients") if c["address"].lower() == want), None)
    if not c or not c.get("floating") or c.get("fullscreen"):
        return
    m = next((m for m in hyprctl_json("monitors") if m["id"] == c["monitor"]), None)
    if not m:
        return
    lw, lh = logical_size(m)
    rl, rt, rr, rb = (list(m.get("reserved", [0, 0, 0, 0])) + [0, 0, 0, 0])[:4]
    uw, uh = lw - rl - rr, lh - rt - rb
    mx, my = m["x"] + rl, m["y"] + rt
    cw, ch = c["size"]
    cx, cy = c["at"]
    dialog = c.get("class") in POPUP_CLASSES
    fw, fh = POPUP_FRACTION if dialog else (SAFE_FRACTION, SAFE_FRACTION)
    nw = int(min(cw, uw * fw))
    nh = int(min(ch, uh * fh))
    outside = cx < mx or cy < my or cx + nw > mx + uw or cy + nh > my + uh
    if (nw, nh) == (cw, ch) and not outside:
        return
    x, y = int(mx + (uw - nw) / 2), int(my + (uh - nh) / 2)
    if verbose:
        print("popup %s: %dx%d -> %dx%d at %d,%d" % (c.get("class"), cw, ch, nw, nh, x, y), flush=True)
    sel = "address:" + c["address"]
    subprocess.run(["hyprctl", "--batch",
                    "dispatch resizewindowpixel exact %d %d,%s ; dispatch movewindowpixel exact %d %d,%s"
                    % (nw, nh, sel, x, y, sel)], capture_output=True, timeout=4)


def hypr_socket():
    sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    rt = os.environ.get("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    if not sig:
        raise RuntimeError("HYPRLAND_INSTANCE_SIGNATURE is not set (not inside Hyprland)")
    return "%s/hypr/%s/.socket2.sock" % (rt, sig)


MON_EVENTS = ("monitoradded", "monitoraddedv2", "monitorremoved", "monitorremovedv2", "configreloaded")


def watch(verbose=False):
    try:
        apply()
    except Exception as e:
        print("genshin-scale: apply failed:", e, file=sys.stderr)
    last_sig = None
    while True:
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.connect(hypr_socket())
        except Exception as e:
            print("genshin-scale: waiting for Hyprland socket:", e, file=sys.stderr)
            time.sleep(2)
            continue
        buf, pending, last_poll, popups = b"", None, time.monotonic(), []
        while True:
            r, _, _ = select.select([s], [], [], 0.25)
            now = time.monotonic()
            if r:
                data = s.recv(65536)
                if not data:
                    break
                buf += data
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    name, _, rest = line.decode("utf-8", "replace").partition(">>")
                    if name in MON_EVENTS:
                        pending = now + 0.8
                    elif name == "openwindow":
                        parts = rest.split(",", 3)
                        if len(parts) == 4:
                            if verbose:
                                print("openwindow class=%r title=%r" % (parts[2], parts[3]), flush=True)
                            popups += [(now + 0.25, parts[0]), (now + 0.9, parts[0])]
            due = [p for p in popups if p[0] <= now]
            popups = [p for p in popups if p[0] > now]
            for _, addr in due:
                try:
                    fit_popup(addr, verbose)
                except Exception as e:
                    print("genshin-scale: popup fit failed:", e, file=sys.stderr)
            if pending and now >= pending:
                pending = None
                try:
                    apply()
                except Exception as e:
                    print("genshin-scale: apply failed:", e, file=sys.stderr)
            if now - last_poll > 15:          # safety net: scale changed without an event
                last_poll = now
                try:
                    m = narrowest_monitor(hyprctl_json("monitors"))
                    sig = (m["width"], m["height"], m.get("scale"), m.get("transform"))
                    if last_sig is not None and sig != last_sig:
                        apply()
                    last_sig = sig
                except Exception:
                    pass
        s.close()


# ═════════════════════════════════════════════════════ cli ══
def main():
    ap = argparse.ArgumentParser(prog="genshin-scale", description="automatic UI scaling for the Genshin desktop")
    sub = ap.add_subparsers(dest="cmd")
    a = sub.add_parser("apply", help="generate style.css / config.jsonc for the current screen")
    a.add_argument("--scale", type=float, help="force a factor instead of detecting it")
    a.add_argument("--monitors-json", help="read monitors from a JSON file (testing)")
    a.add_argument("--dry-run", action="store_true")
    w = sub.add_parser("watch", help="apply, then follow monitor changes and keep popups on screen")
    w.add_argument("-v", "--verbose", action="store_true")
    sub.add_parser("status", help="show what was detected")
    args = ap.parse_args()

    try:
        if args.cmd == "apply":
            apply(args.monitors_json, args.scale, args.dry_run)
        elif args.cmd == "watch":
            watch(args.verbose)
        elif args.cmd == "status":
            apply(dry=True)
        else:
            ap.print_help()
    except KeyboardInterrupt:
        pass
    except Exception as e:
        print("genshin-scale: error:", e, file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
